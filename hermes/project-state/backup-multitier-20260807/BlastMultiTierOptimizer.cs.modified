    public sealed class TierTarget
    {
        public float configuredTargetWinRate;
        public string name;
        public float reachableMaxWinRate;
        public float reachableMinWinRate;
        public bool targetClamped;
        public List<float> targetFailDistribution;
        public float targetWinRate;
    }

    public sealed class MultiTierRunBudget
    {
        public int ConfiguredTierCount;
        public int EffectiveTierCount;
        public long Phase1Runs;
        public long Phase0Runs;
        public long Phase2Runs;
        public long Phase3AppendRuns;
        public long TotalEffectiveRuns;
    }

    public sealed class MultiTierConfig
    {
        public int failBinCount = 10;
        public int gameLevel;

        /// <summary>
        ///     关卡配置分组（如 funnel_b / test），写入导出 CSV 的 <c>LevelGroup</c> 列。
        /// </summary>
        public string levelGroup;

        public int maxWorkers = 6;
        public int outputCount = 1;
        public int phase0Runs = 400;
        public float overflowFactorMax = 1f;
        public float overflowFactorMin = 0f;
        public float phase1FixedOverflowFactor = 0.5f;
        public int phase1FixedShuffleSplitCount = 5;
        public int phase1Runs = 100;
        /// <summary>Phase1 总 sample 软上限（R1a+R1b+R2）；超出时截断 R2。</summary>
        public int phase1Samples = 100;
        public float phase1WinRateMargin = 0.15f;
        /// <summary>R2 每个合格种子的邻域加密次数（默认 4）；总 R2 ∝ 未满足 distinct。</summary>
        public int phase1Round2DensifyPerSeed =
            BlastMultiTierPhase1AdaptiveSampler.Round2DensifyPerSeedDefault;
        public int phase1ExtensionBatchSize = 10;
        public int phase1MinSamplesInTargetBand = 1;
        /// <summary>
        ///     搜索 RNG 种子。0=构造时按时间戳自动派生；非 0=显式复盘同一次搜索轨迹。
        ///     不影响 Bot 对局 <c>BuildSeedBase</c> / seedOffset。
        /// </summary>
        public int searchSeed;
        public int phase2AdvancePerTier = 3;
        public int phase2Runs = 100;
        public int phase2TopPerTier = 20;
        public int phase3Runs = 200;
        public bool preferBfsRawQueue = true;
        public int ratioMax = 10;
        public int ratioMin = 0;

        /// <summary>
        ///     LHS 比例维度；运行时会取 <c>Max(ratioSlots, shuffleSplitCountMax)</c> 作为候选 <c>ratios</c> 长度。
        /// </summary>
        public int ratioSlots = 6;

        public int shuffleSplitCountMax = 6;
        public int shuffleSplitCountMin = 3;
        public int startDifficultyMax = 40;

        // Parameter ranges
        public int startDifficultyMin = 0;
        public BlastBotStrategy strategy = BlastBotStrategy.ScoringOptVg;
        public List<TierTarget> tiers = new();
        public float weightFailDistribution = 0.30f;

        // Weights（仅胜率 / 失败分布两项，UI 按和归一化；默认 0.70/0.30）
        public float weightWinRate = 0.70f;

        /// <summary>
        ///     Excel 或关卡配置中的难度档位（0=Normal,1=Hard,2=SuperHard）；-1 表示导出时回退到 LevelProfileConfig。
        /// </summary>
        public int difficultyLevel = -1;

        // === Phase0 现配先验校验 ===
        public bool priorCheckEnabled = true;

        /// <summary>先验胜率容差（相对目标胜率 ±margin，默认 10%）。</summary>
        public float priorWinRateMargin = 0.1f;

        // === 贝叶斯自适应停止配置 ===
        public bool bayesAdaptiveStopEnabled = true;

        /// <summary>旧单一阈值；未配置分 Phase 阈值时回退用。</summary>
        public float bayesStdThreshold = 0.025f;

        /// <summary>Phase0 累计后验 std 阈值（默认 95% / H=±4.9pp → 0.025）。</summary>
        public float bayesStdThresholdPhase0 = 0.025f;

        /// <summary>Phase1 累计后验 std 阈值（默认 85% / 同 H → 0.034）。</summary>
        public float bayesStdThresholdPhase1 = 0.034f;

        /// <summary>Phase2 累计后验 std 阈值（默认 90% / 同 H → 0.030）。</summary>
        public float bayesStdThresholdPhase2 = 0.030f;

        /// <summary>Phase3 累计后验 std 阈值（默认 95% / 同 H → 0.025）。</summary>
        public float bayesStdThresholdPhase3 = 0.025f;

        public int bayesBatchSize = 10;
        public float bayesPriorAlpha = 2f;
        public float bayesPriorBeta = 2f;

        /// <summary>解析指定 Phase 的后验 std 阈值；未单独配置时回退旧字段。</summary>
        public float ResolveBayesStdThreshold(int phaseIndex)
        {
            switch (phaseIndex)
            {
                case 0:
                    return bayesStdThresholdPhase0 > 0f ? bayesStdThresholdPhase0 : bayesStdThreshold;
                case 1:
                    return bayesStdThresholdPhase1 > 0f ? bayesStdThresholdPhase1 : bayesStdThreshold;
                case 2:
                    return bayesStdThresholdPhase2 > 0f ? bayesStdThresholdPhase2 : bayesStdThreshold;
                case 3:
                    return bayesStdThresholdPhase3 > 0f ? bayesStdThresholdPhase3 : bayesStdThreshold;
                default:
                    return bayesStdThreshold;
            }
        }
    }

    public sealed class ParameterCandidate
    {
        public float overflowFactor;
        public int[] ratios;
        public int shuffleSplitCount;
        public int startDifficulty;

        public ParameterCandidate Clone()
        {
            var len = ratios != null ? ratios.Length : 0;
            var c = new ParameterCandidate
            {
                startDifficulty = startDifficulty,
                shuffleSplitCount = shuffleSplitCount,
                overflowFactor = overflowFactor,
                ratios = len > 0 ? new int[len] : Array.Empty<int>()
            };
            if (ratios != null && len > 0)
                Array.Copy(ratios, c.ratios, len);
            return c;
        }

        public string ToKey()
        {
            var sb = new StringBuilder();
            sb.Append(startDifficulty);
            sb.Append('|');
            sb.Append(shuffleSplitCount);
            sb.Append('|');
            sb.Append(overflowFactor.ToString("0.000", CultureInfo.InvariantCulture));
            sb.Append('|');
            if (ratios != null && ratios.Length > 0)
                for (var i = 0; i < ratios.Length; i++)
                {
                    if (i > 0) sb.Append(',');
                    sb.Append(ratios[i]);
                }
            else
                sb.Append('0');

            return sb.ToString();
        }

        public string RatiosToCsv()
        {
            if (ratios == null || ratios.Length == 0) return string.Empty;
            var sb = new StringBuilder();
            for (var i = 0; i < ratios.Length; i++)
            {
                if (i > 0) sb.Append(',');
                sb.Append(ratios[i]);
            }

            return sb.ToString();
        }

        /// <summary>
        ///     输出长度严格为 <paramref name="splitCount" /> 的 CSV，与
        ///     <see cref="BlastDifficultyApplier" /> / 关卡 seriesConfig 口径一致；不足部分补 <c>1</c>。
        /// </summary>
        public string RatiosToCsvForSplitCount(int splitCount)
        {
            var n = Mathf.Max(1, splitCount);
            var sb = new StringBuilder();
            for (var i = 0; i < n; i++)
            {
                if (i > 0) sb.Append(',');
                var v = ratios != null && i < ratios.Length ? ratios[i] : 1;
                sb.Append(Math.Max(0, v));
            }

            return sb.ToString();
        }

        /// <summary>
        ///     与 <see cref="BlastMultiTierOptimizer.RunEvaluation" /> 写入中性档配置的 ratios 一致；
        ///     telemetry CSV / 报告中的 <c>ShuffleSplitRatios</c> 列应使用本方法而非 <see cref="RatiosToCsv" />。
        /// </summary>
        public string TelemetryShuffleSplitRatiosCsv()
        {
            return RatiosToCsvForSplitCount(shuffleSplitCount);
        }
    }

    public sealed class CandidateEvaluation
    {
        public string phase1SampleKind;
        public ParameterCandidate candidate;
        public float compositeScore;
        public float configuredTargetWinRate;
        public float effectiveTargetWinRate;
        public int[] failBins;
        public int failCount;
        public float failDistScore;
        public bool outOfTargetMargin;
        public float rawGap;
        public float overlapGap;
        public float reachableMaxWinRate;
        public float reachableMinWinRate;
        public List<ParameterSensitivity> sensitivities;
        public float stdErr;
        public float posteriorStd;
        public bool targetClamped;
        public bool Phase2Appended;
        public int winCount;
        public int totalRuns;
        public int plannedRuns;
        public string stopReason; // 备注：为什么停止（full/early/threshold）
        public string sourcePhase; // 如 "p0" / "p3"
        public string status; // "ok" / "failed"（可选）
        public string failureReason;
        public float winRateMatch;
        public float winRate;
    }

    public sealed class ParameterSensitivity
    {
        public float compositeScoreAfter;
        public float compositeScoreBefore;
        public string direction;
        public string paramName;
        public float stepSize;
        public float winRateAfter;
        public float winRateBefore;
    }

    public sealed class BlastMultiTierOptimizer
    {
        private const string Phase1SampleKindBaseline = "baseline";
        private const string Phase1SampleKindMandatory = "mandatory";
        private const string Phase1SampleKindR1Fill = "r1_fill";
        private const string Phase1SampleKindExtension = "extension";

        private readonly MultiTierConfig _config;
        private readonly Dictionary<string, CandidateEvaluation> _evalCache = new();
        private readonly LevelProfileConfig _level;
        private readonly int _searchSeed;
        private readonly string _searchSeedSource;
        private readonly DateTime _runCreated;
        private readonly string _telemetryDir;
        private int _phase1ExtensionSamplesCompleted;
        private Func<bool> _cancelRequested;
        private Action<string, float> _progressReporter;
        private int _cumulativeRuns;
        private ParameterCandidate _phase1BaselineCandidate;
        private List<Phase1TargetTrack> _phase1MandatoryTracks;
        private bool[] _priorSatisfied;
        private CandidateEvaluation[] _priorEvaluations;
        /// <summary>Phase0 复用源档名（如 "T1"）；空表示本档实际跑了仿真。</summary>
        private string[] _priorReusedFromTier;

        /// <summary>置信区间重叠门 Z 系数（约 95%）。</summary>
        private const float ConfidenceZ = 1.96f;

        /// <summary>P1/P2 探索性交叠软门（8pp）。</summary>
        private const float SoftOverlapGap = 0.08f;

        /// <summary>Phase1 绝对胜率上限（15pp）。</summary>
        private const float Phase1AbsoluteCap = 0.15f;

        /// <summary>Phase2→Phase3 绝对胜率上限（12pp）。</summary>
        private const float Phase2AbsoluteCap = 0.12f;

        /// <summary>最终点估计硬门（10pp）。</summary>
        private const float FinalHardGap = 0.10f;

        private int? _cachedNeutralTierIndex;

        /// <summary>Phase1 扩展样本硬上限（mandatory 之外最多再追加）。</summary>
        private const int Phase1MaxExtensionSamples = 40;

        public BlastMultiTierOptimizer(LevelProfileConfig level, MultiTierConfig config, string batchTelemetryRoot = null)
        {
            _level = level;
            _config = config;
            _runCreated = DateTime.Now;
            if (config != null && config.searchSeed != 0)
            {
                _searchSeed = config.searchSeed;
                _searchSeedSource = "explicit";
            }
            else
            {
                _searchSeed = DeriveSearchSeed(
                    _runCreated,
                    config != null ? config.gameLevel : 0,
                    batchTelemetryRoot);
                _searchSeedSource = "auto";
                if (config != null)
                {
                    config.searchSeed = _searchSeed;
                }
            }

            var projectRoot = Directory.GetParent(Application.dataPath)?.FullName ?? Application.dataPath;
            var timestamp = DateTime.Now.ToString(BlastBotExportPathConfig.MultiTierDirTimestampFormat,
                CultureInfo.InvariantCulture);
            var levelName = level != null ? level.name : "unknown";
            _telemetryDir = string.IsNullOrWhiteSpace(batchTelemetryRoot)
                ? BlastBotExportPathConfig.BuildMultiTierStandaloneLevelDir(projectRoot, levelName, timestamp)
                : BlastBotExportPathConfig.BuildMultiTierBatchLevelDir(batchTelemetryRoot, levelName, timestamp);
            Directory.CreateDirectory(_telemetryDir);
            // 把当时使用的 LevelProfileConfig .asset 快照到本关 telemetry 目录 level-assets/ 下。
            if (_config != null)
            {
                BlastBotRangeRunner.TryCopyLevelProfileAssetToTaskDir(
                    _config.gameLevel,
                    ResolveExportLevelGroup(_config),
                    _telemetryDir);
            }

            ExportRunManifest();
            Debug.Log("[MultiTierOptimizer] searchSeed=" + _searchSeed
                      + " source=" + _searchSeedSource
                      + " created=" + _runCreated.ToString("o", CultureInfo.InvariantCulture));
        }

        public string TelemetryDir => _telemetryDir;
        public int SearchSeed => _searchSeed;
        public bool WasCancelled { get; private set; }
        public bool StoppedDueToInsufficientPhase1 { get; private set; }
        /// <summary>任一目标最终选档失败时为 true（Jenkins/批跑应整关失败）。</summary>
        public bool HasFailedTiers { get; private set; }
        public string StopReason { get; private set; }

        /// <summary>阶段晋级硬下限：P1/P2 门内至少 1 个唯一配置才进入下一阶段。</summary>
        private static int ResolveStageHardMinCandidates()
        {
            return 1;
        }

        /// <summary>仅驱动 P1 extension 尽量补齐；不作为失败阈值。</summary>
        private int ResolvePhase1SoftFillTarget()
        {
            return Mathf.Max(
                3,
                Mathf.Max(1, _config.outputCount),
                Mathf.Max(1, _config.phase1MinSamplesInTargetBand));
        }

        private static int DeriveSearchSeed(DateTime createdTime, int gameLevel, string batchTelemetryRoot)
        {
            unchecked
            {
                var hash = (int)(createdTime.Ticks & 0x7FFFFFFF);
                hash ^= gameLevel * 9973;
                if (!string.IsNullOrEmpty(batchTelemetryRoot))
                {
                    hash ^= StringComparer.Ordinal.GetHashCode(batchTelemetryRoot);
                }

                if (hash == 0)
                {
                    hash = 1;
                }

                return hash & 0x7FFFFFFF;
            }
        }

        private Random CreateDerivedRandom(int stageSalt, int ordinal = 0)
        {
            unchecked
            {
                var seed = _searchSeed;
                seed = seed * 397 ^ stageSalt;
                seed = seed * 397 ^ ordinal;
                if (seed == 0)
                {
                    seed = 1;
                }

                return new Random(seed & 0x7FFFFFFF);
            }
        }

        private float ResolveFinalPosteriorStdMax()
        {
            var p0 = _config.ResolveBayesStdThreshold(0);
            var p3 = _config.ResolveBayesStdThreshold(3);
            var thr = Mathf.Min(p0 > 0f ? p0 : 0.025f, p3 > 0f ? p3 : 0.025f);
            return thr > 0f ? thr : 0.025f;
        }

        private float PosteriorMean(CandidateEvaluation eval)
        {
            if (eval == null)
            {
                return 0f;
            }

            var alpha = _config.bayesPriorAlpha + Mathf.Max(0, eval.winCount);
            var beta = _config.bayesPriorBeta + Mathf.Max(0, eval.failCount);
            var total = alpha + beta;
            return total > 0f ? alpha / total : 0f;
        }

        private bool CredibleIntervalOverlapGate(
            CandidateEvaluation eval,
            float configuredTarget,
            float softGap,
            float absoluteCap,
            out float rawGap,
            out float overlapGap)
        {
            rawGap = 0f;
            overlapGap = 0f;
            if (eval == null)
            {
                return false;
            }

            var mu = PosteriorMean(eval);
            rawGap = Mathf.Abs(mu - configuredTarget);
            overlapGap = Mathf.Max(0f, rawGap - ConfidenceZ * Mathf.Max(0f, eval.posteriorStd));
            eval.rawGap = rawGap;
            eval.overlapGap = overlapGap;
            return overlapGap <= softGap + 0.0001f && rawGap <= absoluteCap + 0.0001f;
        }

        private bool FinalHardGate(CandidateEvaluation eval, float configuredTarget)
        {
            if (eval == null)
            {
                return false;
            }

            var mu = PosteriorMean(eval);
            var gap = Mathf.Abs(mu - configuredTarget);
            eval.rawGap = gap;
            eval.overlapGap = Mathf.Max(0f, gap - ConfidenceZ * Mathf.Max(0f, eval.posteriorStd));
            return gap <= FinalHardGap + 0.0001f
                   && eval.posteriorStd <= ResolveFinalPosteriorStdMax() + 0.0001f;
        }

        private int CountUniqueConfigsPassingStageGate(
            IList<CandidateEvaluation> evals,
            float configuredTarget,
            float absoluteCap)
        {
            if (evals == null || evals.Count == 0)
            {
                return 0;
            }

            var keys = new HashSet<string>(StringComparer.Ordinal);
            for (var i = 0; i < evals.Count; i++)
            {
                var eval = evals[i];
                if (eval?.candidate == null)
                {
                    continue;
                }

                if (!CredibleIntervalOverlapGate(eval, configuredTarget, SoftOverlapGap, absoluteCap, out _, out _))
                {
                    continue;
                }

                keys.Add(eval.candidate.ToKey());
            }

            return keys.Count;
        }

        private static string BuildObjectiveKey(TierTarget target)
        {
            var wr = ResolveConfiguredTargetWinRate(target);
            var sb = new StringBuilder();
            sb.Append(BuildTargetWinRateKey(wr));
            sb.Append('|');
            if (target?.targetFailDistribution != null)
            {
                for (var i = 0; i < target.targetFailDistribution.Count; i++)
                {
                    if (i > 0)
                    {
                        sb.Append(',');
                    }

                    sb.Append(target.targetFailDistribution[i].ToString("0.####", CultureInfo.InvariantCulture));
                }
            }

            return sb.ToString();
        }

        private int ResolveNeutralTierIndex()
        {
            if (_cachedNeutralTierIndex.HasValue)
            {
                return _cachedNeutralTierIndex.Value;
            }

            var tierNumber = BlastDynamicDifficultyPureLogic.ResolveNeutralTier(
                BlastUIRuntimeConfigProvider.DataConfig);
            var index = Mathf.Clamp(tierNumber - 1, 0, 4);
            _cachedNeutralTierIndex = index;
            return index;
        }

        private int RatioSlotCount => Mathf.Max(_config.ratioSlots, _config.shuffleSplitCountMax);

        private static int BuildTargetWinRateKey(float targetWinRate)
        {
            return Mathf.RoundToInt(Mathf.Clamp01(targetWinRate) * 10000f);
        }

        public static int CountDistinctTargetWinRates(IList<TierTarget> tiers)
        {
            if (tiers == null || tiers.Count == 0) return 0;

            var keys = new HashSet<int>();
            for (var i = 0; i < tiers.Count; i++)
            {
                var tier = tiers[i];
                if (tier == null) continue;

                keys.Add(BuildTargetWinRateKey(ResolveConfiguredTargetWinRate(tier)));
            }

            return keys.Count;
        }

        /// <summary>
        ///     与当前 <see cref="Run" /> 路径一致的有效局数预算：Phase0–3（Phase3 仅 append）。
        ///     Phase3 早停会减少实际 append 次数，此处为上限。
        /// </summary>
        public static MultiTierRunBudget BuildRunBudget(MultiTierConfig config, int outputCount)
        {
            var configuredTierCount = config.tiers != null ? config.tiers.Count : 0;
            var effectiveTierCount = CountDistinctTargetWinRates(config.tiers);
            var phase2Advance = Mathf.Max(1, config.phase2AdvancePerTier);
            var phase0Runs = (long) configuredTierCount * Mathf.Max(1, config.phase0Runs);
            var phase1Runs = (long) config.phase1Samples * config.phase1Runs;
            var phase2Runs = (long) effectiveTierCount * config.phase2TopPerTier * config.phase2Runs;
            var phase3AppendRuns = (long) effectiveTierCount * phase2Advance * config.phase3Runs;

            return new MultiTierRunBudget
            {
                ConfiguredTierCount = configuredTierCount,
                EffectiveTierCount = effectiveTierCount,
                Phase0Runs = phase0Runs,
                Phase1Runs = phase1Runs,
                Phase2Runs = phase2Runs,
                Phase3AppendRuns = phase3AppendRuns,
                TotalEffectiveRuns = phase0Runs + phase1Runs + phase2Runs + phase3AppendRuns
            };
        }

        public static string BuildRunBudgetText(MultiTierConfig config, int outputCount)
        {
            var budget = BuildRunBudget(config, outputCount);
            var hardMin = ResolveStageHardMinCandidates();
            var softFill = Mathf.Max(
                3,
                Mathf.Max(1, outputCount),
                Mathf.Max(1, config.phase1MinSamplesInTargetBand));
            var phase2Advance = Mathf.Max(1, config.phase2AdvancePerTier);
            var extensionWorstCaseRuns = (long) Phase1MaxExtensionSamples * config.phase1Runs;
            var sb = new StringBuilder();
            sb.AppendLine("[Run Budget]");
            sb.AppendLine("tierCount.configured=" + budget.ConfiguredTierCount);
            sb.AppendLine("tierCount.effective(distinctTargetWinRate)=" + budget.EffectiveTierCount);
            sb.AppendLine("stageHardMin=" + hardMin
                          + " phase1SoftFill=max(3,outputCount,phase1MinSamplesInTargetBand)=" + softFill
                          + " outputCount=" + Mathf.Max(1, outputCount));
            sb.AppendLine("phase0.priorCheck=" + (config.priorCheckEnabled ? "enabled" : "disabled")
                          + " finalHardGate=±" + FinalHardGap.ToString("P0", CultureInfo.InvariantCulture)
                          + " runs/uniqueAssetConfig≤" + Mathf.Max(1, config.phase0Runs)
                          + " totalUpperBound=" + budget.Phase0Runs
                          + " (duplicate asset configs share one sim)"
                          + " bayes=" + (config.bayesAdaptiveStopEnabled ? "on" : "off")
                          + " thr=" + config.ResolveBayesStdThreshold(0).ToString("0.000", CultureInfo.InvariantCulture));
            sb.AppendLine("bayes.adaptiveStop=" + (config.bayesAdaptiveStopEnabled ? "enabled" : "disabled")
                          + " batchSize=" + config.bayesBatchSize
                          + " thrP0/P1/P2/P3="
                          + config.ResolveBayesStdThreshold(0).ToString("0.000", CultureInfo.InvariantCulture) + "/"
                          + config.ResolveBayesStdThreshold(1).ToString("0.000", CultureInfo.InvariantCulture) + "/"
                          + config.ResolveBayesStdThreshold(2).ToString("0.000", CultureInfo.InvariantCulture) + "/"
                          + config.ResolveBayesStdThreshold(3).ToString("0.000", CultureInfo.InvariantCulture)
                          + " (cumulative posterior)");
            sb.AppendLine("stageGate.softOverlapGap=" + SoftOverlapGap.ToString("P0", CultureInfo.InvariantCulture)
                          + " confidenceZ=" + ConfidenceZ.ToString("0.##", CultureInfo.InvariantCulture)
                          + " p1AbsCap=" + Phase1AbsoluteCap.ToString("P0", CultureInfo.InvariantCulture)
                          + " p2AbsCap=" + Phase2AbsoluteCap.ToString("P0", CultureInfo.InvariantCulture));
            sb.AppendLine("phase1.margin=" + config.phase1WinRateMargin.ToString("P0", CultureInfo.InvariantCulture));
            sb.AppendLine("phase1.fixedShuffleSplitCount=" + config.phase1FixedShuffleSplitCount);
            sb.AppendLine("phase1.fixedOverflowFactor=" + config.phase1FixedOverflowFactor.ToString("0.###",
                CultureInfo.InvariantCulture));
            sb.AppendLine("phase1.runsSoftCap=" + config.phase1Samples + " samples x " + config.phase1Runs +
                          " runs = " + budget.Phase1Runs +
                          " (baseline + R1a presets + R1b binary-fill + R2 neighborhood densify@" +
                          Mathf.Max(1, config.phase1Round2DensifyPerSeed) +
                          "/seed for unsatisfied distinct; extension max +" +
                          Phase1MaxExtensionSamples + " samples)");
            sb.AppendLine("phase1.hardGate=overlapGate unique configs>=" + hardMin
                          + " before/after extension"
                          + " (soft=" + SoftOverlapGap.ToString("P0", CultureInfo.InvariantCulture)
                          + ", absCap=" + Phase1AbsoluteCap.ToString("P0", CultureInfo.InvariantCulture) + ")");
            sb.AppendLine("phase1.softFillTarget=" + softFill
                          + " (extension continues while any unsatisfied tier is below target)");
            sb.AppendLine("phase1.extensionBatch=" + config.phase1ExtensionBatchSize
                          + " (targeted toward deficit tier configured WR; recheck after each candidate)");
            sb.AppendLine("phase1.extensionStrategy=deficit-tier targeted sampling (not pure LHS)");
            sb.AppendLine("phase1.extensionMaxSamples=" + Phase1MaxExtensionSamples
                                                        + ", extensionWorstCaseRuns=" + extensionWorstCaseRuns);
            sb.AppendLine("phase2.select=nearest " + config.phase2TopPerTier + " passing P1 overlap gate");
            sb.AppendLine("phase2.runs=" + budget.EffectiveTierCount + " tiers x " + config.phase2TopPerTier +
                          " candidates x " + config.phase2Runs + " appended runs = " + budget.Phase2Runs);
            sb.AppendLine("phase2.passGate=overlapGate absCap=" + Phase2AbsoluteCap.ToString("P0", CultureInfo.InvariantCulture)
                          + " require>=" + hardMin);
            sb.AppendLine("phase2.cumulativeRunsPerCandidate=" + config.phase1Runs + " + " + config.phase2Runs +
                          " = " + (config.phase1Runs + config.phase2Runs));
            sb.AppendLine("phase3.appendRuns=" + budget.EffectiveTierCount + " tiers x " + phase2Advance +
                          " candidates x " + config.phase3Runs + " runs = " + budget.Phase3AppendRuns +
                          " (run all advance; filter posteriorStd; no inter-candidate early-stop)");
            sb.AppendLine("final.pool=Phase0+Phase3 hardGate=±" + FinalHardGap.ToString("P0", CultureInfo.InvariantCulture)
                          + " weights=" + config.weightWinRate.ToString("0.##", CultureInfo.InvariantCulture)
                          + "/" + config.weightFailDistribution.ToString("0.##", CultureInfo.InvariantCulture));
            sb.AppendLine("totalEffectiveRuns=" + budget.TotalEffectiveRuns +
                          " (matches cumulative bot runs unless Bayes earlyStop; extension worst +" +
                          extensionWorstCaseRuns + ")");
            return sb.ToString();
        }

        /// <summary>
        ///     与 Bot 批跑 <c>campaign-summary.csv</c> 的 <c>failBucketDistribution</c> 同格式：失败局在各进度分箱的占比（逗号分隔、Invariant），无失败局时为长度
        ///     <paramref name="binCount" /> 的全 0。
        /// </summary>
        private static string FormatFailBucketDistributionCsv(int[] failBins, int failCount, int binCount)
        {
            if (binCount <= 0) return string.Empty;

            var parts = new string[binCount];
            if (failCount <= 0)
            {
                for (var i = 0; i < binCount; i++) parts[i] = "0";

                return string.Join(",", parts);
            }

            for (var i = 0; i < binCount; i++)
            {
                var c = failBins != null && i < failBins.Length ? failBins[i] : 0;
                parts[i] = (c / (float) failCount).ToString("0.###", CultureInfo.InvariantCulture);
            }

            return string.Join(",", parts);
        }

        public List<CandidateEvaluation> Run(Action<string, float> onProgress = null)
        {
            return Run(onProgress, null);
        }

        public List<CandidateEvaluation> Run(Action<string, float> onProgress, Func<bool> cancelRequested)
        {
            _progressReporter = onProgress;
            _cancelRequested = cancelRequested;
            WasCancelled = false;
            StoppedDueToInsufficientPhase1 = false;
            HasFailedTiers = false;
            StopReason = null;
            _cumulativeRuns = 0;
            _phase1ExtensionSamplesCompleted = 0;
            _cachedNeutralTierIndex = null;
            _phase1MandatoryTracks = null;
            _priorSatisfied = null;
            _priorEvaluations = null;
            _priorReusedFromTier = null;
            var finalResults = new List<CandidateEvaluation>();
            var distinctTargets = BuildDistinctTierTargets(_config.tiers, out var tierToDistinctIndex);
            if (distinctTargets.Count == 0) return finalResults;

            if (RunPhase0PriorChecks(_config.tiers, out _))
            {
                WasCancelled = true;
                return finalResults;
            }

            if (_config.priorCheckEnabled && AreAllConfiguredTiersPriorSatisfied(_config.tiers))
            {
                var priorOnly = BuildFinalResultsFromCommonPool(
                    CollectPhase0PoolEvaluations(),
                    null,
                    _config.tiers,
                    Mathf.Max(1, _config.outputCount));
                ExportFinalCsv(priorOnly);
                ReportProgress("Phase 0: 全部档位先验满足，已跳过 Phase1-3（统一最终筛选）", 1f);
                Debug.Log("[MultiTierOptimizer] Phase0: all tiers satisfied — skipped Phase1/2/3, ran unified final selection");
                return priorOnly;
            }

            ReportProgress("Phase 1: 关卡现配基准 + 参数偏移采样…", 0.02f);

            var mandatoryCount = Mathf.Max(1, _config.phase1Samples);
            _phase1BaselineCandidate = BuildBaselineCandidateFromLevel();
            var allPhase1Evals = new List<CandidateEvaluation>(mandatoryCount);
            var phase1Slice = mandatoryCount > 0 ? 0.15f / mandatoryCount : 0f;
            var phase1SampleIndex = 0;

            if (_phase1BaselineCandidate != null)
            {
                if (IsCancelled())
                {
                    WasCancelled = true;
                    return finalResults;
                }

                var baselineEval = RunEvaluation(
                    _phase1BaselineCandidate,
                    _config.phase1Runs,
                    GetPhase1SeedOffset(),
                    "p1b",
                    "Phase 1: baseline (asset T3 config)",
                    phase1SampleIndex * phase1Slice,
                    phase1Slice);
                if (baselineEval == null)
                {
                    WasCancelled = true;
                    return finalResults;
                }

                baselineEval.phase1SampleKind = Phase1SampleKindBaseline;
                baselineEval.sourcePhase = "p1";
                allPhase1Evals.Add(baselineEval);
                phase1SampleIndex++;
                ReportProgress(
                    $"Phase 1: baseline 1/{mandatoryCount}, current {_config.phase1Runs}/{_config.phase1Runs} runs",
                    (float) phase1SampleIndex / mandatoryCount * 0.15f);
            }

            var phase1SeenKeys = BuildPhase1SeenKeysFromEvals(allPhase1Evals);
            var phase1PlanningSeenKeys = new HashSet<string>(phase1SeenKeys, StringComparer.Ordinal);

            var phase1AdaptiveMandatoryEvals = new List<CandidateEvaluation>();
            var sampleSoftCap = Mathf.Max(1, mandatoryCount);
            var round1Count = Mathf.Min(
                BlastMultiTierPhase1AdaptiveSampler.Round1TotalPresetCount,
                Mathf.Max(0, sampleSoftCap - phase1SampleIndex
                - BlastMultiTierPhase1AdaptiveSampler.Round1BinaryFillGlobalCap));

            var round1Plans = BlastMultiTierPhase1AdaptiveSampler.BuildRound1Plans(
                _config,
                round1Count,
                phase1PlanningSeenKeys);
            for (var i = 0; i < round1Plans.Count; i++)
            {
                if (IsCancelled())
                {
                    WasCancelled = true;
                    return finalResults;
                }

                if (phase1SampleIndex >= sampleSoftCap)
                {
                    break;
                }

                var globalSample = phase1SampleIndex + 1;
                var eval = RunPhase1MandatorySample(
                    round1Plans[i].candidate,
                    phase1SampleIndex,
                    1,
                    "p1r1",
                    $"Phase 1 Round 1: sample {globalSample}/{sampleSoftCap}, {round1Plans[i].targetLabel}",
                    phase1SampleIndex * phase1Slice,
                    phase1Slice,
                    phase1SeenKeys);
                if (eval == null)
                {
                    if (IsCancelled())
                    {
                        WasCancelled = true;
                        return finalResults;
                    }

                    continue;
                }

                eval.phase1SampleKind = Phase1SampleKindMandatory;
                allPhase1Evals.Add(eval);
                phase1AdaptiveMandatoryEvals.Add(eval);
                phase1SampleIndex++;
                ReportProgress(
                    $"Phase 1 Round 1: sample {globalSample}/{sampleSoftCap}, current {_config.phase1Runs}/{_config.phase1Runs} runs",
                    (float) phase1SampleIndex / sampleSoftCap * 0.15f);
            }

            var focusTargets = CollectUnsatisfiedConfiguredTargetWinRates(_config.tiers);
            var segmentDepth = new Dictionary<string, int>(StringComparer.Ordinal);
            var fillRemaining = Mathf.Min(
                BlastMultiTierPhase1AdaptiveSampler.Round1BinaryFillGlobalCap,
                Mathf.Max(0, sampleSoftCap - phase1SampleIndex));
            while (fillRemaining > 0 && focusTargets.Count > 0)
            {
                if (IsCancelled())
                {
                    WasCancelled = true;
                    return finalResults;
                }

                var fillPlans = BlastMultiTierPhase1AdaptiveSampler.BuildRound1BinaryFillPlans(
                    _config,
                    focusTargets,
                    allPhase1Evals,
                    _config.phase1WinRateMargin,
                    phase1PlanningSeenKeys,
                    segmentDepth,
                    fillRemaining);
                if (fillPlans == null || fillPlans.Count == 0)
                {
                    break;
                }

                var executedThisWave = 0;
                for (var i = 0; i < fillPlans.Count; i++)
                {
                    if (IsCancelled())
                    {
                        WasCancelled = true;
                        return finalResults;
                    }

                    if (phase1SampleIndex >= sampleSoftCap)
                    {
                        break;
                    }

                    var globalSample = phase1SampleIndex + 1;
                    var eval = RunPhase1MandatorySample(
                        fillPlans[i].candidate,
                        phase1SampleIndex,
                        11 + i,
                        "p1r1f",
                        $"Phase 1 Round 1 fill: sample {globalSample}/{sampleSoftCap}, {fillPlans[i].targetLabel}",
                        phase1SampleIndex * phase1Slice,
                        phase1Slice,
                        phase1SeenKeys);
                    if (eval == null)
                    {
                        if (IsCancelled())
                        {
                            WasCancelled = true;
                            return finalResults;
                        }

                        continue;
                    }

                    eval.phase1SampleKind = Phase1SampleKindR1Fill;
                    allPhase1Evals.Add(eval);
                    phase1AdaptiveMandatoryEvals.Add(eval);
                    phase1SampleIndex++;
                        executedThisWave++;
                    fillRemaining--;
                    ReportProgress(
                        $"Phase 1 Round 1 fill: sample {globalSample}/{sampleSoftCap}, current {_config.phase1Runs}/{_config.phase1Runs} runs",
                        (float) phase1SampleIndex / sampleSoftCap * 0.15f);
                }

                if (executedThisWave == 0)
                {
                    break;
                }
            }

            var densifyPerSeed = Mathf.Max(1, _config.phase1Round2DensifyPerSeed);
            var round2MaxPlans = Mathf.Max(0, sampleSoftCap - phase1SampleIndex);
            var round2Plans = BlastMultiTierPhase1AdaptiveSampler.BuildRound2NeighborhoodPlans(
                _config,
                focusTargets,
                allPhase1Evals,
                _config.phase1WinRateMargin,
                densifyPerSeed,
                phase1PlanningSeenKeys,
                round2MaxPlans,
                CreateDerivedRandom(21001));
            for (var i = 0; i < round2Plans.Count; i++)
            {
                if (IsCancelled())
                {
                    WasCancelled = true;
                    return finalResults;
                }

                if (phase1SampleIndex >= sampleSoftCap)
                {
                    break;
                }

                var globalSample = phase1SampleIndex + 1;
                var eval = RunPhase1MandatorySample(
                    round2Plans[i].candidate,
                    phase1SampleIndex,
                    2,
                    "p1r2",
                    $"Phase 1 Round 2: sample {globalSample}/{sampleSoftCap}, {round2Plans[i].targetLabel}",
                    phase1SampleIndex * phase1Slice,
                    phase1Slice,
                    phase1SeenKeys);
                if (eval == null)
                {
                    if (IsCancelled())
                    {
                        WasCancelled = true;
                        return finalResults;
                    }

                    continue;
                }

                eval.phase1SampleKind = Phase1SampleKindMandatory;
                allPhase1Evals.Add(eval);
                phase1AdaptiveMandatoryEvals.Add(eval);
                phase1SampleIndex++;
                ReportProgress(
                    $"Phase 1 Round 2: sample {globalSample}/{sampleSoftCap}, current {_config.phase1Runs}/{_config.phase1Runs} runs",
                    (float) phase1SampleIndex / sampleSoftCap * 0.15f);
            }

            Debug.Log("[MultiTierOptimizer] Phase1 scoped: unsatisfiedDistinct="
                      + focusTargets.Count
                      + " densifyPerSeed=" + densifyPerSeed
                      + " executedSamples=" + phase1SampleIndex
                      + "/" + sampleSoftCap);

            allPhase1Evals.Sort((a, b) => b.winRate.CompareTo(a.winRate));

            var maxObservedWinRate = allPhase1Evals.Count > 0 ? allPhase1Evals[0].winRate : 0f;

            var targetAdjustment =
                BlastMultiTierTargetAdjuster.BuildAdjustedTargets(_config.tiers, allPhase1Evals, maxObservedWinRate);
            distinctTargets = BuildDistinctTierTargets(targetAdjustment.adjustedTiers, out tierToDistinctIndex);
            if (distinctTargets.Count == 0) return finalResults;

            var extensionBatch = Mathf.Max(1, _config.phase1ExtensionBatchSize);
            var extensionIndex = 0;
            if (!TryValidatePhase1HardMinimum(allPhase1Evals, out var phase1HardPreReason))
            {
                ExportPhase1Raw(allPhase1Evals);
                ExportPhase1ReachabilityReport(allPhase1Evals);
                StoppedDueToInsufficientPhase1 = true;
                HasFailedTiers = true;
                StopReason = phase1HardPreReason;
                Debug.LogWarning("[MultiTierOptimizer] " + phase1HardPreReason);
                Debug.LogWarning("[MultiTierOptimizer] Phase1 硬下限未满足（extension 前），已跳过扩展与 Phase2/3；请查看 "
                                 + Path.Combine(_telemetryDir, "phase1_reachability.csv"));
                return finalResults;
            }

            while (!IsPhase1SoftFillSatisfied(allPhase1Evals)
                   && extensionIndex < Phase1MaxExtensionSamples)
            {
                if (IsCancelled())
                {
                    WasCancelled = true;
                    return finalResults;
                }

                var extensionRemaining = Phase1MaxExtensionSamples - extensionIndex;
                var batchCount = Mathf.Min(extensionBatch, extensionRemaining);
                if (batchCount <= 0)
                {
                    break;
                }

                var batchSamples = GenerateTargetedPhase1ExtensionSamples(
                    batchCount,
                    allPhase1Evals,
                    extensionIndex,
                    out var extensionFocusLog);
                var stopExtension = false;
                for (var bi = 0; bi < batchSamples.Count; bi++)
                {
                    if (extensionIndex >= Phase1MaxExtensionSamples)
                    {
                        break;
                    }

                    if (IsCancelled())
                    {
                        WasCancelled = true;
                        return finalResults;
                    }

                    extensionIndex++;
                    _phase1ExtensionSamplesCompleted = extensionIndex;
                    var globalIndex = allPhase1Evals.Count + 1;
                    var progressLabel = string.IsNullOrEmpty(extensionFocusLog)
                        ? $"Phase 1 扩展: sample {globalIndex} (batch {extensionIndex})"
                        : $"Phase 1 扩展(定向→{extensionFocusLog}): sample {globalIndex} (batch {extensionIndex})";
                    var eval = RunEvaluation(
                        batchSamples[bi],
                        _config.phase1Runs,
                        GetPhase1SeedOffset(),
                        "p1x",
                        progressLabel,
                        0.14f,
                        0.01f / Math.Max(1, extensionBatch));
                    if (eval == null)
                    {
                        WasCancelled = true;
                        return finalResults;
                    }

                    eval.phase1SampleKind = Phase1SampleKindExtension;
                    eval.sourcePhase = "p1";
                    allPhase1Evals.Add(eval);

                    allPhase1Evals.Sort((a, b) => b.winRate.CompareTo(a.winRate));
                    maxObservedWinRate = allPhase1Evals.Count > 0 ? allPhase1Evals[0].winRate : 0f;
                    targetAdjustment =
                        BlastMultiTierTargetAdjuster.BuildAdjustedTargets(_config.tiers, allPhase1Evals, maxObservedWinRate);
                    distinctTargets = BuildDistinctTierTargets(targetAdjustment.adjustedTiers, out tierToDistinctIndex);
                    if (distinctTargets.Count == 0)
                    {
                        return finalResults;
                    }

                    if (IsPhase1SoftFillSatisfied(allPhase1Evals))
                    {
                        stopExtension = true;
                        break;
                    }
                }

                if (stopExtension)
                {
                    break;
                }

                if (batchSamples.Count == 0)
                {
                    break;
                }
            }

            _phase1ExtensionSamplesCompleted = extensionIndex;
            if (extensionIndex >= Phase1MaxExtensionSamples
                && !IsPhase1SoftFillSatisfied(allPhase1Evals))
            {
                Debug.Log("[MultiTierOptimizer] Phase1 扩展巡查已达样本上限 "
                          + Phase1MaxExtensionSamples + "，停止追加采样（硬下限仍按 >=1 校验）。");
            }

            ExportPhase1Raw(allPhase1Evals);
            ExportPhase1ReachabilityReport(allPhase1Evals);

            if (!TryValidatePhase1HardMinimum(allPhase1Evals, out var phase1StopReason))
            {
                StoppedDueToInsufficientPhase1 = true;
                HasFailedTiers = true;
                StopReason = phase1StopReason;
                Debug.LogWarning("[MultiTierOptimizer] " + phase1StopReason);
                Debug.LogWarning("[MultiTierOptimizer] Phase1 硬下限未满足，已跳过 Phase2/3；请查看 "
                                 + Path.Combine(_telemetryDir, "phase1_reachability.csv"));
                return finalResults;
            }

            var distinctTierCount = distinctTargets.Count;

            ReportProgress("Phase 2: 综合评分筛选…", 0.15f);

            var tierTopCandidates = new List<List<CandidateEvaluation>>();
            var tierPhase2PassedCandidates = new List<List<CandidateEvaluation>>();
            for (var t = 0; t < distinctTierCount; t++)
            {
                if (IsCancelled())
                {
                    WasCancelled = true;
                    return finalResults;
                }

                if (!DistinctTargetNeedsOptimization(t, tierToDistinctIndex, _priorSatisfied))
                {
                    tierTopCandidates.Add(new List<CandidateEvaluation>());
                    tierPhase2PassedCandidates.Add(new List<CandidateEvaluation>());
                    ReportProgress($"Phase 2: tier {distinctTargets[t].name} skipped (prior satisfied)",
                        0.17f + 0.23f * (t + 1) / distinctTierCount);
                    continue;
                }

                var target = distinctTargets[t];
                var configuredTarget = ResolveConfiguredTargetWinRate(target);
                var hardMin = ResolveStageHardMinCandidates();
                var candidates = SelectTopForTier(allPhase1Evals, target, _config.phase2TopPerTier);
                var candidateCount = Math.Max(1, candidates.Count);
                var phase2TierBase = 0.15f + 0.25f * t / Mathf.Max(1, distinctTierCount);
                var phase2TierSlice = 0.25f / Mathf.Max(1, distinctTierCount);
                var phase2CandidateSlice = phase2TierSlice / candidateCount;
                var phase2SeedOffset = GetPhase2SeedOffset();

                tierTopCandidates.Add(candidates);
                var passedCandidates = new List<CandidateEvaluation>();
                for (var i = 0; i < candidates.Count; i++)
                {
                    var additional = RunEvaluation(
                        candidates[i].candidate,
                        _config.phase2Runs,
                        phase2SeedOffset,
                        "p2",
                        $"Phase 2: {target.name} {i + 1}/{candidates.Count} candidates",
                        phase2TierBase + i * phase2CandidateSlice,
                        phase2CandidateSlice,
                        priorWins: candidates[i].winCount,
                        priorLosses: candidates[i].failCount);
                    if (additional == null)
                    {
                        WasCancelled = true;
                        return finalResults;
                    }

                    var merged = MergeEvaluations(candidates[i], additional);
                    merged.sourcePhase = "p2";
                    UpdateCompositeScore(merged, target);
                    merged.Phase2Appended = true;
                    if (!CredibleIntervalOverlapGate(merged, configuredTarget, SoftOverlapGap, Phase2AbsoluteCap,
                            out _, out _))
                    {
                        merged.outOfTargetMargin = true;
                        candidates[i] = merged;
                        continue;
                    }

                    merged.outOfTargetMargin = false;
                    candidates[i] = merged;
                    passedCandidates.Add(merged);
                }

                tierPhase2PassedCandidates.Add(passedCandidates);
                var uniquePassed = CountUniqueConfigsPassingStageGate(passedCandidates, configuredTarget, Phase2AbsoluteCap);
                if (uniquePassed < hardMin)
                {
                    HasFailedTiers = true;
                    StopReason = "Phase2 档位 " + target.name + " 追加后门内唯一候选仅 "
                                 + uniquePassed + " 个(需要至少 " + hardMin
                                 + ")，absCap=" + Phase2AbsoluteCap.ToString("P0", CultureInfo.InvariantCulture)
                                 + "，已停止后续流程。";
                    Debug.LogWarning("[MultiTierOptimizer] " + StopReason);
                    ExportPhase2Candidates(tierTopCandidates, distinctTargets);
                    return finalResults;
                }

                candidates.Sort((a, b) => b.compositeScore.CompareTo(a.compositeScore));
                ReportProgress($"Phase 2: tier {target.name} done",
                    0.15f + 0.25f * (t + 1) / distinctTierCount);
            }

            ExportPhase2Candidates(tierTopCandidates, distinctTargets);

            var outputCount = Math.Max(1, _config.outputCount);

            // Phase 3: append phase3Runs to Phase 1+2 merged results (coordinate search not in current path).
            ReportProgress("Phase 3: 追加局数…", 0.40f);

            var optimizedByDistinct = new List<CandidateEvaluation>[distinctTierCount];

                for (var t = 0; t < distinctTierCount; t++)
                {
                    if (IsCancelled()) { WasCancelled = true; return finalResults; }
                    if (!DistinctTargetNeedsOptimization(t, tierToDistinctIndex, _priorSatisfied))
                    {
                        ReportProgress($"Phase 3: tier {distinctTargets[t].name} skipped (prior satisfied)",
                            0.42f + 0.38f * (t + 1) / distinctTierCount);
                        continue;
                    }

                    var target = distinctTargets[t];
                    var topCandidates = tierPhase2PassedCandidates[t];
                    var configuredTarget = ResolveConfiguredTargetWinRate(target);
                    var phase3SeedOffset = GetPhase3SeedOffset();
                    var advanceLimit = Mathf.Max(1, _config.phase2AdvancePerTier);
                    // P2: 分带选取（不扩 candidate 数，避免 phase3 局数预算翻倍）。
                    // 保证 advanced 集合横跨目标邻域：贴档主力 + 下探(WR明显低于目标) + 上探(WR高于目标)。
                    // 供 P0 单调联合选档提供 WR 跨度，而不是全簇在目标附近。
                    var advValid = topCandidates.Where(candidate => candidate != null).OrderByDescending(candidate => candidate.compositeScore).ToList();
                    var advPool = advValid.Count > 0 ? advValid : topCandidates.Where(candidate => candidate != null).ToList();
                    var advSelected = new List<CandidateEvaluation>();
                    // 1) 最贴近目标（贴档主力）
                    var closest = advPool.OrderBy(c => Math.Abs(PosteriorMean(c) - configuredTarget)).FirstOrDefault();
                    if (closest != null) advSelected.Add(closest);
                    // 2) 下探：WR 明显低于目标（供 gap 到下一较低档）
                    var below = advPool.Where(c => PosteriorMean(c) < configuredTarget - 0.03f)
                        .OrderByDescending(c => PosteriorMean(c)).FirstOrDefault();
                    if (below != null && !advSelected.Contains(below)) advSelected.Add(below);
                    // 3) 上探：WR 高于目标
                    var above = advPool.Where(c => PosteriorMean(c) > configuredTarget + 0.03f)
                        .OrderBy(c => PosteriorMean(c)).FirstOrDefault();
                    if (above != null && !advSelected.Contains(above)) advSelected.Add(above);
                    // 4) 补齐到 advanceLimit（按离目标最近）
                    foreach (var c in advPool.OrderBy(c => Math.Abs(PosteriorMean(c) - configuredTarget)))
                    {
                        if (advSelected.Count >= advanceLimit) break;
                        if (!advSelected.Contains(c)) advSelected.Add(c);
                    }
                    var advanceCandidates = advSelected.Take(advanceLimit).ToList();
                    var advance = advanceCandidates.Count;
                    var phase3TierBase = 0.40f + 0.40f * t / Mathf.Max(1, distinctTierCount);
                    var phase3TierSlice = 0.40f / Mathf.Max(1, distinctTierCount);
                    var phase3CandidateSlice = advance > 0 ? phase3TierSlice / advance : phase3TierSlice;

                    var searchedForTier = new List<CandidateEvaluation>();
                    var finalStdMax = ResolveFinalPosteriorStdMax();

                    for (var a = 0; a < advance; a++)
                    {
                        if (IsCancelled()) { WasCancelled = true; return finalResults; }

                        var current = advanceCandidates[a];
                        var additional = RunEvaluation(
                            current.candidate,
                            _config.phase3Runs,
                            phase3SeedOffset,
                            "p3",
                            $"Phase 3: {target.name} candidate {a + 1}/{advance}, append {_config.phase3Runs}runs",
                            phase3TierBase + a * phase3CandidateSlice,
                            phase3CandidateSlice,
                            priorWins: current.winCount,
                            priorLosses: current.failCount);
                        if (additional == null) { WasCancelled = true; return finalResults; }

                        var merged = MergeEvaluations(current, additional);
                        merged.sourcePhase = "p3";
                        UpdateCompositeScore(merged, target);
                        // Keep ALL executed Phase3 candidates; precision filter applies in BuildCommonFinalPool.
                        if (merged.posteriorStd > finalStdMax + 0.0001f)
                        {
                            merged.outOfTargetMargin = true;
                            Debug.Log("[MultiTierOptimizer] Phase3 candidate will fail final precision filter posteriorStd="
                                      + merged.posteriorStd.ToString("0.0000", CultureInfo.InvariantCulture)
                                      + " > " + finalStdMax.ToString("0.0000", CultureInfo.InvariantCulture)
                                      + " (" + target.name + ")");
                        }

                        searchedForTier.Add(merged);
                    }

                    searchedForTier.Sort((a, b) => b.compositeScore.CompareTo(a.compositeScore));
                    optimizedByDistinct[t] = searchedForTier;

                    ReportProgress($"Phase 3: tier {target.name} done ({searchedForTier.Count}/{advance})",
                        0.40f + 0.40f * (t + 1) / distinctTierCount);
                }

            // Phase3 结束后强制 GC，再进最终选档；无 Phase4。
            GC.Collect();
            GC.WaitForPendingFinalizers();
            GC.Collect();

            finalResults = BuildFinalResultsFromCommonPool(
                CollectPhase0PoolEvaluations(),
                optimizedByDistinct,
                targetAdjustment.adjustedTiers,
                outputCount);
            ExportFinalCsv(finalResults);

            return finalResults;
        }

        private static List<TierTarget> BuildDistinctTierTargets(IList<TierTarget> tiers,
            out List<int> tierToDistinctIndex)
        {
            tierToDistinctIndex = new List<int>();
            var distinct = new List<TierTarget>();
            if (tiers == null || tiers.Count == 0) return distinct;

            var keyToDistinct = new Dictionary<int, int>();
            for (var i = 0; i < tiers.Count; i++)
            {
                var tier = tiers[i];
                if (tier == null)
                {
                    tierToDistinctIndex.Add(-1);
                    continue;
                }

                var key = BuildTargetWinRateKey(ResolveConfiguredTargetWinRate(tier));
                if (!keyToDistinct.TryGetValue(key, out var distinctIndex))
                {
                    distinctIndex = distinct.Count;
                    keyToDistinct.Add(key, distinctIndex);
                    distinct.Add(tier);
                }

                tierToDistinctIndex.Add(distinctIndex);
            }

            return distinct;
        }

        private List<CandidateEvaluation> ExpandResultsToConfiguredTiers(List<CandidateEvaluation> distinctResults,
            int outputCount, IList<int> tierToDistinctIndex, IList<TierTarget> configuredTiers)
        {
            var expanded = new List<CandidateEvaluation>();
            if (distinctResults == null || distinctResults.Count == 0 || tierToDistinctIndex == null ||
                tierToDistinctIndex.Count == 0)
                return expanded;

            var perTierCount = Mathf.Max(1, outputCount);
            for (var tier = 0; tier < tierToDistinctIndex.Count; tier++)
            {
                var distinctTier = tierToDistinctIndex[tier];
                if (distinctTier < 0) continue;

                for (var rank = 0; rank < perTierCount; rank++)
                {
                    var sourceIndex = distinctTier * perTierCount + rank;
                    if (sourceIndex < 0 || sourceIndex >= distinctResults.Count) break;

                    var target = configuredTiers != null && tier < configuredTiers.Count ? configuredTiers[tier] : null;
                    expanded.Add(CloneEvaluationForTarget(distinctResults[sourceIndex], target));
                }
            }

            return expanded;
        }

        private List<CandidateEvaluation> CollectPhase0PoolEvaluations()
        {
            var pool = new List<CandidateEvaluation>();
            if (_priorEvaluations == null)
            {
                return pool;
            }

            for (var i = 0; i < _priorEvaluations.Length; i++)
            {
                if (_priorEvaluations[i] != null)
                {
                    pool.Add(_priorEvaluations[i]);
                }
            }

            return pool;
        }

        private static List<CandidateEvaluation> DedupFinalPoolByCandidateKey(IList<CandidateEvaluation> pool)
        {
            var byKey = new Dictionary<string, CandidateEvaluation>(StringComparer.Ordinal);
            if (pool == null)
            {
                return new List<CandidateEvaluation>();
            }

            for (var i = 0; i < pool.Count; i++)
            {
                var eval = pool[i];
                if (eval?.candidate == null)
                {
                    continue;
                }

                var key = eval.candidate.ToKey();
                if (!byKey.TryGetValue(key, out var existing))
                {
                    byKey[key] = eval;
                    continue;
                }

                // Prefer more totalRuns, then better (smaller) posteriorStd.
                if (eval.totalRuns > existing.totalRuns
                    || (eval.totalRuns == existing.totalRuns && eval.posteriorStd < existing.posteriorStd - 0.0000001f))
                {
                    byKey[key] = eval;
                }
            }

            return new List<CandidateEvaluation>(byKey.Values);
        }

        private List<CandidateEvaluation> BuildCommonFinalPool(
            IList<CandidateEvaluation> phase0Pool,
            IList<List<CandidateEvaluation>> phase3ByDistinct)
        {
            var pool = new List<CandidateEvaluation>();
            if (phase0Pool != null)
            {
                for (var i = 0; i < phase0Pool.Count; i++)
                {
                    if (phase0Pool[i] != null)
                    {
                        pool.Add(phase0Pool[i]);
                    }
                }
            }

            var finalStdMax = ResolveFinalPosteriorStdMax();
            if (phase3ByDistinct != null)
            {
                for (var d = 0; d < phase3ByDistinct.Count; d++)
                {
                    var list = phase3ByDistinct[d];
                    if (list == null)
                    {
                        continue;
                    }

                    for (var i = 0; i < list.Count; i++)
                    {
                        var eval = list[i];
                        if (eval == null)
                        {
                            continue;
                        }

                        // Precision filter only: keep executed P3 that meet final std.
                        if (eval.posteriorStd <= finalStdMax + 0.0001f)
                        {
                            pool.Add(eval);
                        }
                    }
                }
            }

            return DedupFinalPoolByCandidateKey(pool);
        }

        private int CompareFinalCandidates(CandidateEvaluation a, CandidateEvaluation b, float configured)
        {
            if (a == null && b == null)
            {
                return 0;
            }

            if (a == null)
            {
                return 1;
            }

            if (b == null)
            {
                return -1;
            }

            var scoreCmp = b.compositeScore.CompareTo(a.compositeScore);
            if (scoreCmp != 0)
            {
                return scoreCmp;
            }

            var gapA = Mathf.Abs(PosteriorMean(a) - configured);
            var gapB = Mathf.Abs(PosteriorMean(b) - configured);
            var gapCmp = gapA.CompareTo(gapB);
            if (gapCmp != 0)
            {
                return gapCmp;
            }

            var runsCmp = b.totalRuns.CompareTo(a.totalRuns);
            if (runsCmp != 0)
            {
                return runsCmp;
            }

            var stdCmp = a.posteriorStd.CompareTo(b.posteriorStd);
            if (stdCmp != 0)
            {
                return stdCmp;
            }

            var keyA = a.candidate != null ? a.candidate.ToKey() : string.Empty;
            var keyB = b.candidate != null ? b.candidate.ToKey() : string.Empty;
            return string.CompareOrdinal(keyA, keyB);
        }

        private CandidateEvaluation BuildFailedTierEvaluation(TierTarget target, string reason)
        {
            var eval = new CandidateEvaluation
            {
                candidate = new ParameterCandidate
                {
                    startDifficulty = 0,
                    shuffleSplitCount = Mathf.Max(1, _config.phase1FixedShuffleSplitCount),
                    overflowFactor = _config.phase1FixedOverflowFactor,
                    ratios = new[] {1}
                },
                status = "failed",
                failureReason = reason ?? "final_selection_failed",
                stopReason = reason ?? "final_selection_failed",
                sourcePhase = "",
                outOfTargetMargin = true,
                totalRuns = 0,
                plannedRuns = 0
            };
            if (target != null)
            {
                eval.configuredTargetWinRate = ResolveConfiguredTargetWinRate(target);
                eval.effectiveTargetWinRate = target.targetWinRate;
                eval.targetClamped = target.targetClamped;
                eval.reachableMinWinRate = target.reachableMinWinRate;
                eval.reachableMaxWinRate = target.reachableMaxWinRate;
            }

            return eval;
        }

        /// <summary>
        ///     Unified final selection: common pool = Phase0 + Phase3 executed (precision-filtered),
        ///     hard gate then composite score; same objectiveKey selected once and expanded.
        /// </summary>
        private List<CandidateEvaluation> BuildFinalResultsFromCommonPool(
            IList<CandidateEvaluation> phase0Pool,
            IList<List<CandidateEvaluation>> phase3ByDistinct,
            IList<TierTarget> configuredTiers,
            int outputCount)
        {
            var results = new List<CandidateEvaluation>();
            if (configuredTiers == null || configuredTiers.Count == 0)
            {
                return results;
            }

            var perTierCount = Mathf.Max(1, outputCount);
            var pool = BuildCommonFinalPool(phase0Pool, phase3ByDistinct);
            var selectionByObjective = new Dictionary<string, List<CandidateEvaluation>>(StringComparer.Ordinal);
            var failureByObjective = new Dictionary<string, string>(StringComparer.Ordinal);
            var anyFailed = false;

            for (var tier = 0; tier < configuredTiers.Count; tier++)
            {
                var target = configuredTiers[tier];
                if (target == null)
                {
                    continue;
                }

                var objectiveKey = BuildObjectiveKey(target);
                if (selectionByObjective.ContainsKey(objectiveKey) || failureByObjective.ContainsKey(objectiveKey))
                {
                    continue;
                }

                var configured = ResolveConfiguredTargetWinRate(target);
                var passed = new List<CandidateEvaluation>();
                for (var i = 0; i < pool.Count; i++)
                {
                    var source = pool[i];
                    if (source?.candidate == null)
                    {
                        continue;
                    }

                    var clone = CloneEvaluationForTarget(source, target);
                    if (clone == null)
                    {
                        continue;
                    }

                    if (!FinalHardGate(clone, configured))
                    {
                        clone.outOfTargetMargin = true;
                        continue;
                    }

                    clone.outOfTargetMargin = false;
                    clone.status = "ok";
                    UpdateCompositeScore(clone, target);
                    passed.Add(clone);
                }

                passed.Sort((a, b) => CompareFinalCandidates(a, b, configured));

                // Dedup by config key after scoring for unique outputs.
                var unique = new List<CandidateEvaluation>();
                var seen = new HashSet<string>(StringComparer.Ordinal);
                for (var i = 0; i < passed.Count; i++)
                {
                    var key = passed[i].candidate.ToKey();
                    if (!seen.Add(key))
                    {
                        continue;
                    }

                    unique.Add(passed[i]);
                    if (unique.Count >= perTierCount)
                    {
                        break;
                    }
                }

                if (unique.Count < perTierCount)
                {
                    anyFailed = true;
                    var reason = "FinalSelection 目标 " + (target.name ?? objectiveKey)
                                 + " 硬门合格唯一配置仅 " + unique.Count
                                 + " 个(需要 " + perTierCount + ")";
                    failureByObjective[objectiveKey] = reason;
                    Debug.LogWarning("[MultiTierOptimizer] " + reason);
                }
                else
                {
                    selectionByObjective[objectiveKey] = unique;
                }
            }

            for (var tier = 0; tier < configuredTiers.Count; tier++)
            {
                var target = configuredTiers[tier];
                if (target == null)
                {
                    continue;
                }

                var objectiveKey = BuildObjectiveKey(target);
                if (selectionByObjective.TryGetValue(objectiveKey, out var chosen))
                {
                    for (var rank = 0; rank < perTierCount; rank++)
                    {
                        var src = rank < chosen.Count ? chosen[rank] : chosen[chosen.Count - 1];
                        results.Add(CloneEvaluationForTarget(src, target));
                    }
                }
                else
                {
                    var reason = failureByObjective.TryGetValue(objectiveKey, out var fr)
                        ? fr
                        : "FinalSelection failed";
                    for (var rank = 0; rank < perTierCount; rank++)
                    {
                        results.Add(BuildFailedTierEvaluation(target, reason));
                    }
                }
            }
            if (anyFailed)
            {
                HasFailedTiers = true;
                if (string.IsNullOrEmpty(StopReason))
                {
                    StopReason = "至少一个目标最终选档失败（HasFailedTiers）。";
                }
            }

            return results;
        }

        private static bool DistinctTargetNeedsOptimization(
            int distinctIndex,
            IList<int> tierToDistinctIndex,
            bool[] priorSatisfied)
        {
            if (tierToDistinctIndex == null) return true;
            for (var i = 0; i < tierToDistinctIndex.Count; i++)
            {
                if (tierToDistinctIndex[i] != distinctIndex) continue;
                if (priorSatisfied == null || i >= priorSatisfied.Length || !priorSatisfied[i])
                    return true;
            }

            return false;
        }

        private bool RunPhase0PriorChecks(IList<TierTarget> tiers, out int satisfiedCount)
        {
            satisfiedCount = 0;
            var tierCount = tiers?.Count ?? 0;
            _priorSatisfied = tierCount > 0 ? new bool[tierCount] : null;
            _priorEvaluations = tierCount > 0 ? new CandidateEvaluation[tierCount] : null;
            _priorReusedFromTier = tierCount > 0 ? new string[tierCount] : null;

            if (!_config.priorCheckEnabled || tierCount == 0)
                return false;

            var maxRuns = Mathf.Max(1, _config.phase0Runs);
            // Same asset DynamicDifficultyConfig (ToKey) → one Bot sim; other tiers clone + per-target gate.
            var simByAssetConfigKey = new Dictionary<string, CandidateEvaluation>(StringComparer.Ordinal);
            var firstTierByAssetConfigKey = new Dictionary<string, int>(StringComparer.Ordinal);
            var uniqueSimCount = 0;

            ReportProgress("Phase 0: 现配先验校验（FinalHardGate ±"
                           + FinalHardGap.ToString("P0", CultureInfo.InvariantCulture)
                           + "；同配置只仿真一次）…", 0f);

            for (var i = 0; i < tierCount; i++)
            {
                if (IsCancelled())
                {
                    return true;
                }

                var target = tiers[i];
                if (target == null)
                {
                    continue;
                }

                var tierNumber = i + 1;
                var candidate = BuildCandidateFromAssetTier(tierNumber);
                if (candidate == null)
                {
                    continue;
                }

                var assetConfigKey = candidate.ToKey();
                var slice = 0.02f / Mathf.Max(1, tierCount);
                CandidateEvaluation simResult;
                var reusedFromTier = string.Empty;
                if (simByAssetConfigKey.TryGetValue(assetConfigKey, out simResult))
                {
                    reusedFromTier = "T" + firstTierByAssetConfigKey[assetConfigKey]
                        .ToString(CultureInfo.InvariantCulture);
                    ReportProgress(
                        $"Phase 0: {target.name} prior reuse {reusedFromTier} (asset T{tierNumber} same config)",
                        0.02f * (i + 1) / tierCount);
                }
                else
                {
                    // Unified protocol: apply candidate to neutral tier; seed offset 0 for all P0.
                    simResult = RunEvaluation(
                        candidate,
                        maxRuns,
                        0,
                        "p0",
                        $"Phase 0: {target.name} prior (asset T{tierNumber} → neutral)",
                        0.02f * i / tierCount,
                        slice,
                        forcedDynamicTier: null,
                        applyCandidateToStack: true,
                        bayesStdThresholdOverride: _config.ResolveBayesStdThreshold(0));
                    if (simResult == null)
                    {
                        if (IsCancelled())
                        {
                            return true;
                        }

                        continue;
                    }

                    simByAssetConfigKey[assetConfigKey] = simResult;
                    firstTierByAssetConfigKey[assetConfigKey] = tierNumber;
                    uniqueSimCount++;
                }

                // Clone so per-tier FinalHardGate / compositeScore do not mutate the shared sim record.
                var eval = CloneEvaluationForTarget(simResult, target);
                if (eval == null)
                {
                    continue;
                }

                eval.sourcePhase = "p0";
                _priorEvaluations[i] = eval;
                _priorReusedFromTier[i] = reusedFromTier;

                var configured = ResolveConfiguredTargetWinRate(target);
                _priorSatisfied[i] = FinalHardGate(eval, configured);
                eval.outOfTargetMargin = !_priorSatisfied[i];
                if (_priorSatisfied[i])
                {
                    satisfiedCount++;
                }

                ReportProgress(
                    $"Phase 0: {target.name} prior μ={PosteriorMean(eval):P1} vs {configured:P1} std={eval.posteriorStd:0.000} => " +
                    (_priorSatisfied[i] ? "skip" : "optimize")
                    + (string.IsNullOrEmpty(reusedFromTier) ? "" : " (reused " + reusedFromTier + ")"),
                    0.02f * (i + 1) / tierCount);
            }

            ExportPhase0PriorReport(tiers);
            Debug.Log("[MultiTierOptimizer] Phase0 prior: satisfied " + satisfiedCount + "/" + tierCount);
            return false;
        }

        /// <summary>
        ///     每个有效配置档均完成先验且落在容差内时返回 true（此时无需 Phase1 改参）。
        /// </summary>
        private bool AreAllConfiguredTiersPriorSatisfied(IList<TierTarget> tiers)
        {
            if (tiers == null || tiers.Count == 0 || _priorSatisfied == null || _priorEvaluations == null)
                return false;

            var checkedCount = 0;
            for (var i = 0; i < tiers.Count; i++)
            {
                if (tiers[i] == null) continue;
                checkedCount++;
                if (i >= _priorEvaluations.Length || _priorEvaluations[i] == null)
                    return false;
                if (i >= _priorSatisfied.Length || !_priorSatisfied[i])
                    return false;
            }

            return checkedCount > 0;
        }

        private void ExportPhase0PriorReport(IList<TierTarget> tiers)
        {
            if (tiers == null || _priorEvaluations == null) return;

            var levelGroup = ResolveExportLevelGroup(_config);
            var lines = new List<string>
            {
                "LevelGroup,Tier,ConfiguredTargetWinRate,PriorWinRate,PosteriorMean,RawGap,OverlapGap,PosteriorStd," +
                "TotalRuns,PlannedRuns,StopReason,SourcePhase," +
                "StartDifficulty,ShuffleSplitCount,ShuffleSplitRatios,ShuffleOverflowFactor,Satisfied,ReusedFromTier"
            };

            for (var i = 0; i < tiers.Count; i++)
            {
                var target = tiers[i];
                var eval = i < _priorEvaluations.Length ? _priorEvaluations[i] : null;
                if (target == null || eval == null) continue;

                var configured = ResolveConfiguredTargetWinRate(target);
                var mu = PosteriorMean(eval);
                var satisfied = _priorSatisfied != null && i < _priorSatisfied.Length && _priorSatisfied[i];
                var reusedFrom = _priorReusedFromTier != null && i < _priorReusedFromTier.Length
                    ? (_priorReusedFromTier[i] ?? string.Empty)
                    : string.Empty;

                lines.Add(string.Join(",",
                    levelGroup,
                    target.name,
                    configured.ToString("0.####", CultureInfo.InvariantCulture),
                    eval.winRate.ToString("0.####", CultureInfo.InvariantCulture),
                    mu.ToString("0.####", CultureInfo.InvariantCulture),
                    eval.rawGap.ToString("0.####", CultureInfo.InvariantCulture),
                    eval.overlapGap.ToString("0.####", CultureInfo.InvariantCulture),
                    eval.posteriorStd.ToString("0.####", CultureInfo.InvariantCulture),
                    eval.totalRuns.ToString(CultureInfo.InvariantCulture),
                    eval.plannedRuns.ToString(CultureInfo.InvariantCulture),
                    eval.stopReason ?? "",
                    eval.sourcePhase ?? "p0",
                    eval.candidate.startDifficulty.ToString(CultureInfo.InvariantCulture),
                    eval.candidate.shuffleSplitCount.ToString(CultureInfo.InvariantCulture),
                    "\"" + eval.candidate.TelemetryShuffleSplitRatiosCsv() + "\"",
                    eval.candidate.overflowFactor.ToString("0.###", CultureInfo.InvariantCulture),
                    satisfied ? "true" : "false",
                    reusedFrom));
            }

            var reportPath = Path.Combine(_telemetryDir, "phase0_prior.csv");
            File.WriteAllText(reportPath, string.Join("\n", lines));
            Debug.Log("[MultiTierOptimizer] Phase0 prior report exported: " + reportPath.Replace('\\', '/'));
        }

        private CandidateEvaluation CloneEvaluationForTarget(CandidateEvaluation source, TierTarget target)
        {
            if (source == null)
            {
                return null;
            }

            var clone = new CandidateEvaluation
            {
                candidate = source.candidate,
                compositeScore = source.compositeScore,
                failBins = source.failBins,
                failCount = source.failCount,
                failDistScore = source.failDistScore,
                sensitivities = source.sensitivities,
                stdErr = source.stdErr,
                posteriorStd = source.posteriorStd,
                Phase2Appended = source.Phase2Appended,
                winCount = source.winCount,
                totalRuns = source.totalRuns,
                plannedRuns = source.plannedRuns,
                stopReason = source.stopReason,
                sourcePhase = source.sourcePhase,
                status = source.status,
                failureReason = source.failureReason,
                rawGap = source.rawGap,
                overlapGap = source.overlapGap,
                outOfTargetMargin = source.outOfTargetMargin,
                winRate = source.winRate,
                phase1SampleKind = source.phase1SampleKind
            };

            if (target != null)
            {
                UpdateCompositeScore(clone, target);
            }
            else
            {
                CopyEvalResult(clone, source);
            }

            return clone;
        }

        /// <summary>
        ///     以零分配扫描返回当前候选集的最高分与对应胜率，供 Phase3 早停判定使用。
        /// </summary>
        private static void GetBestScoreAndWinRate(IList<CandidateEvaluation> evaluations, out float bestScore,
            out float bestWinRate)
        {
            bestScore = float.MinValue;
            bestWinRate = float.MinValue;
            if (evaluations == null || evaluations.Count == 0)
                return;

            for (var i = 0; i < evaluations.Count; i++)
            {
                var eval = evaluations[i];
                if (eval == null)
                    continue;
                if (eval.compositeScore <= bestScore)
                    continue;
                bestScore = eval.compositeScore;
                bestWinRate = eval.winRate;
            }
        }

        /// <summary>
        ///     返回 topN 的分数下边界（第 N 名分数）；若候选数不足 N 返回 float.MinValue。
        /// </summary>
        private static float GetTopBoundaryScore(IList<CandidateEvaluation> evaluations, int topCount)
        {
            if (evaluations == null || topCount <= 0 || evaluations.Count < topCount)
                return float.MinValue;

            var count = evaluations.Count;
            Span<bool> selected = count <= 1024 ? stackalloc bool[count] : new bool[count];
            var boundary = float.MinValue;

            for (var rank = 0; rank < topCount; rank++)
            {
                var bestIdx = -1;
                var bestScore = float.MinValue;
                for (var i = 0; i < count; i++)
                {
                    if (selected[i])
                        continue;
                    var eval = evaluations[i];
                    if (eval == null || eval.compositeScore <= bestScore)
                        continue;
                    bestScore = eval.compositeScore;
                    bestIdx = i;
                }

                if (bestIdx < 0)
                    return float.MinValue;
                selected[bestIdx] = true;
                boundary = bestScore;
            }

            return boundary;
        }

        private static void CopyEvalResult(CandidateEvaluation dst, CandidateEvaluation src)
        {
            dst.configuredTargetWinRate = src.configuredTargetWinRate;
            dst.winRate = src.winRate;
            dst.winCount = src.winCount;
            dst.failCount = src.failCount;
            dst.failBins = src.failBins;
            dst.failDistScore = src.failDistScore;
            dst.compositeScore = src.compositeScore;
            dst.effectiveTargetWinRate = src.effectiveTargetWinRate;
            dst.outOfTargetMargin = src.outOfTargetMargin;
            dst.rawGap = src.rawGap;
            dst.overlapGap = src.overlapGap;
            dst.reachableMaxWinRate = src.reachableMaxWinRate;
            dst.reachableMinWinRate = src.reachableMinWinRate;
            dst.stdErr = src.stdErr;
            dst.posteriorStd = src.posteriorStd;
            dst.targetClamped = src.targetClamped;
            dst.Phase2Appended = src.Phase2Appended;
            dst.totalRuns = src.totalRuns;
            dst.plannedRuns = src.plannedRuns;
            dst.stopReason = src.stopReason;
            dst.sourcePhase = src.sourcePhase;
            dst.status = src.status;
            dst.failureReason = src.failureReason;
            dst.winRateMatch = src.winRateMatch;
            dst.phase1SampleKind = src.phase1SampleKind;
        }

        private int GetPhase1SeedOffset()
        {
            return 0;
        }

        private int GetPhase2SeedOffset()
        {
            return _config.phase1Runs * BlastBotRunPolicy.SeedStride;
        }

        private int GetPhase3SeedOffset()
        {
            return (_config.phase1Runs + _config.phase2Runs) * BlastBotRunPolicy.SeedStride;
        }

        private ParameterCandidate BuildBaselineCandidateFromLevel()
        {
            var tier = BlastDynamicDifficultyPureLogic.ResolveNeutralTier(BlastUIRuntimeConfigProvider.DataConfig);
            return BuildCandidateFromAssetTier(tier);
        }

        private ParameterCandidate BuildCandidateFromAssetTier(int tier)
        {
            var stack = _level != null ? _level.Stack : null;
            if (stack == null)
                return null;

            var effective = BlastDynamicDifficultyPureLogic.ResolveTierDifficultyConfig(stack, tier);
            var splitCount = Mathf.Max(1, effective.shuffleSplitCount);
            return new ParameterCandidate
            {
                startDifficulty = effective.startDifficulty,
                shuffleSplitCount = splitCount,
                overflowFactor = effective.shuffleOverflowFactor,
                ratios = ParseRatiosCsv(effective.shuffleSplitRatios, RatioSlotCount)
            };
        }

        private static void EnsureRatioCapacity(ParameterCandidate candidate, int ratioDim)
        {
            if (candidate == null) return;
            var dim = Math.Max(1, ratioDim);
            if (candidate.ratios != null && candidate.ratios.Length >= dim) return;

            var resized = new int[dim];
            for (var i = 0; i < dim; i++)
                resized[i] = candidate.ratios != null && i < candidate.ratios.Length ? candidate.ratios[i] : 1;
            candidate.ratios = resized;
        }

        private int[] ParseRatiosCsv(string csv, int ratioDim)
        {
            var dim = Math.Max(1, ratioDim);
            var ratios = new int[dim];
            for (var i = 0; i < dim; i++)
                ratios[i] = 1;

            if (string.IsNullOrWhiteSpace(csv))
                return ratios;

            var parts = csv.Split(',');
            var len = Math.Min(dim, parts.Length);
            for (var i = 0; i < len; i++)
            {
                if (!int.TryParse(parts[i].Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var v))
                    continue;
                ratios[i] = Mathf.Clamp(v, _config.ratioMin, _config.ratioMax);
            }

            return ratios;
        }

        private ParameterCandidate TryGetPhase1BaselineCandidate(IList<CandidateEvaluation> evals)
        {
            if (_phase1BaselineCandidate != null)
                return _phase1BaselineCandidate.Clone();

            if (evals == null) return null;
            for (var i = 0; i < evals.Count; i++)
            {
                var eval = evals[i];
                if (eval?.candidate == null) continue;
                if (!string.Equals(eval.phase1SampleKind, Phase1SampleKindBaseline, StringComparison.Ordinal))
                    continue;
                return eval.candidate.Clone();
            }

            return null;
        }

        private static Phase1WinRateSamplingDirection ResolveDirectionTowardTargetWinRate(
            float currentWinRate,
            float targetWinRate)
        {
            const float eps = 0.005f;
            if (currentWinRate + eps < targetWinRate)
                return Phase1WinRateSamplingDirection.TowardHigher;
            if (currentWinRate > targetWinRate + eps)
                return Phase1WinRateSamplingDirection.TowardLower;
            return Phase1WinRateSamplingDirection.TowardCenter;
        }

        private static List<float> CollectDistinctConfiguredTargetWinRates(IList<TierTarget> tiers)
        {
            var targets = new List<float>();
            if (tiers == null || tiers.Count == 0)
                return targets;

            var seen = new HashSet<int>();
            for (var i = 0; i < tiers.Count; i++)
            {
                var configured = ResolveConfiguredTargetWinRate(tiers[i]);
                if (configured <= 0f) continue;
                var key = BuildTargetWinRateKey(configured);
                if (!seen.Add(key)) continue;
                targets.Add(configured);
            }

            return targets;
        }

        /// <summary>
        ///     Phase0 未满足档对应的 distinct 配置胜率（高→低）；prior 关闭时等同全部 distinct。
        /// </summary>
        private List<float> CollectUnsatisfiedConfiguredTargetWinRates(IList<TierTarget> tiers)
        {
            if (tiers == null || tiers.Count == 0)
                return new List<float>();

            if (!_config.priorCheckEnabled || _priorSatisfied == null)
                return CollectDistinctConfiguredTargetWinRates(tiers);

            var unsatisfiedKeys = new HashSet<int>();
            for (var i = 0; i < tiers.Count; i++)
            {
                if (IsPhase0PriorSatisfiedAt(i))
                    continue;

                var configured = ResolveConfiguredTargetWinRate(tiers[i]);
                if (configured <= 0f)
                    continue;

                unsatisfiedKeys.Add(BuildTargetWinRateKey(configured));
            }

            var targets = new List<float>();
            var seen = new HashSet<int>();
            for (var i = 0; i < tiers.Count; i++)
            {
                var configured = ResolveConfiguredTargetWinRate(tiers[i]);
                if (configured <= 0f)
                    continue;

                var key = BuildTargetWinRateKey(configured);
                if (!unsatisfiedKeys.Contains(key) || !seen.Add(key))
                    continue;

                targets.Add(configured);
            }

            targets.Sort((left, right) => right.CompareTo(left));
            return targets;
        }

        private static List<int> BuildCenterOutTargetOrder(int count)
        {
            var order = new List<int>(count);
            if (count <= 0)
                return order;

            var center = count / 2;
            order.Add(center);
            for (var i = center - 1; i >= 0; i--)
                order.Add(i);
            for (var i = center + 1; i < count; i++)
                order.Add(i);
            return order;
        }

        private float TryGetPhase1BaselineWinRate(IList<CandidateEvaluation> evals)
        {
            if (evals == null) return 0f;
            for (var i = 0; i < evals.Count; i++)
            {
                var eval = evals[i];
                if (eval == null) continue;
                if (!string.Equals(eval.phase1SampleKind, Phase1SampleKindBaseline, StringComparison.Ordinal))
                    continue;
                return eval.winRate;
            }

            return 0f;
        }

        private List<Phase1TargetTrack> BuildPhase1TargetTracks(
            ParameterCandidate baseline,
            float baselineWinRate,
            IList<TierTarget> tiers)
        {
            var tracks = new List<Phase1TargetTrack>();
            if (baseline == null)
                return tracks;

            var targets = CollectDistinctConfiguredTargetWinRates(tiers);
            if (targets.Count == 0)
                targets.Add(0.5f);

            var order = BuildCenterOutTargetOrder(targets.Count);
            var centerTrackIndex = -1;
            var leftParent = -1;
            var rightParent = -1;
            var centerOrderPos = targets.Count / 2;
            for (var orderPos = 0; orderPos < order.Count; orderPos++)
            {
                var targetIdx = order[orderPos];
                var targetWinRate = targets[targetIdx];
                var candidate = baseline.Clone();
                EnsureRatioCapacity(candidate, RatioSlotCount);

                var parentTrackIndex = -1;
                if (orderPos == 0)
                {
                    centerTrackIndex = tracks.Count;
                }
                else if (orderPos <= centerOrderPos)
                {
                    parentTrackIndex = leftParent >= 0 ? leftParent : centerTrackIndex;
                }
                else
                {
                    parentTrackIndex = rightParent >= 0 ? rightParent : centerTrackIndex;
                }

                tracks.Add(new Phase1TargetTrack
                {
                    targetWinRate = targetWinRate,
                    direction = ResolveDirectionTowardTargetWinRate(baselineWinRate, targetWinRate),
                    lastObservedWinRate = baselineWinRate,
                    currentCandidate = candidate,
                    parentTrackIndex = parentTrackIndex,
                    stepIndex = 0
                });

                if (orderPos > 0)
                {
                    if (orderPos <= centerOrderPos)
                        leftParent = tracks.Count - 1;
                    else
                        rightParent = tracks.Count - 1;
                }
            }

            return tracks;
        }

        private static List<Phase1TargetTrack> ClonePhase1TargetTracks(IList<Phase1TargetTrack> tracks)
        {
            var cloned = new List<Phase1TargetTrack>();
            if (tracks == null)
                return cloned;

            for (var i = 0; i < tracks.Count; i++)
            {
                var track = tracks[i];
                if (track == null || track.currentCandidate == null)
                    continue;
                cloned.Add(new Phase1TargetTrack
                {
                    targetWinRate = track.targetWinRate,
                    direction = track.direction,
                    lastObservedWinRate = track.lastObservedWinRate,
                    currentCandidate = track.currentCandidate.Clone(),
                    parentTrackIndex = track.parentTrackIndex,
                    stepIndex = track.stepIndex
                });
            }

            return cloned;
        }

        private ParameterCandidate GenerateNextGoalDirectedMandatorySample(
            IList<Phase1TargetTrack> tracks,
            int sampleIndex,
            ISet<string> existingKeys,
            out Phase1TargetTrack selectedTrack)
        {
            selectedTrack = null;
            if (tracks == null || tracks.Count == 0)
                return null;

            var trackIndex = Mathf.Abs(sampleIndex) % tracks.Count;
            selectedTrack = tracks[trackIndex];
            if (selectedTrack == null)
                return null;

            var sourceTrack = selectedTrack;
            if (selectedTrack.stepIndex == 0
                && selectedTrack.parentTrackIndex >= 0
                && selectedTrack.parentTrackIndex < tracks.Count
                && tracks[selectedTrack.parentTrackIndex]?.currentCandidate != null)
            {
                sourceTrack = tracks[selectedTrack.parentTrackIndex];
                selectedTrack.currentCandidate = sourceTrack.currentCandidate.Clone();
                selectedTrack.lastObservedWinRate = sourceTrack.lastObservedWinRate;
                selectedTrack.direction = ResolveDirectionTowardTargetWinRate(
                    selectedTrack.lastObservedWinRate,
                    selectedTrack.targetWinRate);
            }

            if (selectedTrack.currentCandidate == null)
                return null;

            var candidate = selectedTrack.currentCandidate.Clone();
            EnsureRatioCapacity(candidate, RatioSlotCount);

            var nudgeSalt = sampleIndex * 17 + selectedTrack.stepIndex * 5;
            ApplyMandatoryTrackNudge(candidate, selectedTrack, nudgeSalt);

            var attempts = 0;
            while (existingKeys != null && existingKeys.Contains(candidate.ToKey()) && attempts < 8)
            {
                ApplyMandatoryTrackNudge(candidate, selectedTrack, nudgeSalt + attempts + 1);
                attempts++;
            }

            existingKeys?.Add(candidate.ToKey());
            return candidate;
        }

        private void ApplyMandatoryTrackNudge(
            ParameterCandidate candidate,
            Phase1TargetTrack track,
            int salt)
        {
            if (candidate == null || track == null)
                return;

            var deltaAbs = Mathf.Abs(track.targetWinRate - track.lastObservedWinRate);
            var startStep = deltaAbs > 0.20f ? 3 : deltaAbs > 0.10f ? 2 : 1;
            var overflowStep = deltaAbs > 0.20f ? 0.03f : deltaAbs > 0.10f ? 0.02f : 0.01f;
            var shouldAdjustSplit = deltaAbs > 0.04f;
            var ratioSlots = deltaAbs > 0.20f ? 2 : 1;

            switch (track.direction)
            {
                case Phase1WinRateSamplingDirection.TowardHigher:
                    candidate.startDifficulty = Mathf.Clamp(
                        candidate.startDifficulty - startStep,
                        _config.startDifficultyMin,
                        _config.startDifficultyMax);
                    if (shouldAdjustSplit)
                    {
                        candidate.shuffleSplitCount = Mathf.Clamp(
                            candidate.shuffleSplitCount + 1,
                            _config.shuffleSplitCountMin,
                            _config.shuffleSplitCountMax);
                    }
                    candidate.overflowFactor = Mathf.Clamp(
                        candidate.overflowFactor - overflowStep,
                        _config.overflowFactorMin,
                        _config.overflowFactorMax);
                    break;
                case Phase1WinRateSamplingDirection.TowardLower:
                    candidate.startDifficulty = Mathf.Clamp(
                        candidate.startDifficulty + startStep,
                        _config.startDifficultyMin,
                        _config.startDifficultyMax);
                    if (shouldAdjustSplit)
                    {
                        candidate.shuffleSplitCount = Mathf.Clamp(
                            candidate.shuffleSplitCount - 1,
                            _config.shuffleSplitCountMin,
                            _config.shuffleSplitCountMax);
                    }
                    candidate.overflowFactor = Mathf.Clamp(
                        candidate.overflowFactor + overflowStep,
                        _config.overflowFactorMin,
                        _config.overflowFactorMax);
                    break;
                default:
                {
                    var towardHigher = salt % 2 == 0;
                    candidate.startDifficulty = Mathf.Clamp(
                        candidate.startDifficulty + (towardHigher ? -1 : 1),
                        _config.startDifficultyMin,
                        _config.startDifficultyMax);
                    candidate.overflowFactor = Mathf.Clamp(
                        candidate.overflowFactor + (towardHigher ? -0.01f : 0.01f),
                        _config.overflowFactorMin,
                        _config.overflowFactorMax);
                    break;
                }
            }

            if (candidate.ratios == null || candidate.ratios.Length == 0)
                return;

            var ratioDirection = track.direction == Phase1WinRateSamplingDirection.TowardLower ? 1 : -1;
            for (var i = 0; i < ratioSlots; i++)
            {
                var slot = (salt + i) % candidate.ratios.Length;
                candidate.ratios[slot] = Mathf.Clamp(
                    candidate.ratios[slot] + (track.direction == Phase1WinRateSamplingDirection.TowardCenter
                        ? (i % 2 == 0 ? -1 : 1)
                        : ratioDirection),
                    _config.ratioMin,
                    _config.ratioMax);
            }
        }

        private static void UpdatePhase1TargetTrack(Phase1TargetTrack track, CandidateEvaluation eval)
        {
            if (track == null || eval?.candidate == null)
                return;

            track.currentCandidate = eval.candidate.Clone();
            track.lastObservedWinRate = eval.winRate;
            track.direction = ResolveDirectionTowardTargetWinRate(eval.winRate, track.targetWinRate);
            track.stepIndex++;
        }

        private List<ParameterCandidate> GeneratePhase1ExtensionFallbackSamples(
            IList<CandidateEvaluation> evals,
            int count,
            int globalIndexOffset)
        {
            var samples = new List<ParameterCandidate>(count);
            var existingKeys = new HashSet<string>(StringComparer.Ordinal);
            if (evals != null)
            {
                for (var i = 0; i < evals.Count; i++)
                {
                    var candidate = evals[i]?.candidate;
                    if (candidate == null)
                        continue;
                    existingKeys.Add(candidate.ToKey());
                }
            }

            var tracks = ClonePhase1TargetTracks(_phase1MandatoryTracks);
            if (tracks.Count == 0)
            {
                var baseline = TryGetPhase1BaselineCandidate(evals);
                if (baseline != null)
                    tracks = BuildPhase1TargetTracks(baseline, TryGetPhase1BaselineWinRate(evals), _config.tiers);
            }

            if (tracks.Count > 0)
            {
                for (var i = 0; i < count; i++)
                {
                    var candidate = GenerateNextGoalDirectedMandatorySample(
                        tracks,
                        globalIndexOffset + i,
                        existingKeys,
                        out var selectedTrack);
                    if (candidate == null)
                        continue;
                    samples.Add(candidate);
                    if (selectedTrack != null)
                    {
                        selectedTrack.currentCandidate = candidate.Clone();
                        selectedTrack.direction = ResolveDirectionTowardTargetWinRate(
                            selectedTrack.lastObservedWinRate,
                            selectedTrack.targetWinRate);
                        selectedTrack.stepIndex++;
                    }
                }

                if (samples.Count > 0)
                    return samples;
            }

            return GenerateLhsSamples(count, globalIndexOffset);
        }

        private static HashSet<string> BuildPhase1SeenKeysFromEvals(IList<CandidateEvaluation> evals)
        {
            var keys = new HashSet<string>(StringComparer.Ordinal);
            if (evals == null)
            {
                return keys;
            }

            for (var i = 0; i < evals.Count; i++)
            {
                var candidate = evals[i]?.candidate;
                if (candidate == null)
                {
                    continue;
                }

                keys.Add(candidate.ToKey());
            }

            return keys;
        }

        private ParameterCandidate ResolveUniquePhase1MandatoryCandidate(
            ParameterCandidate planned,
            int sampleIndex,
            int roundSalt,
            HashSet<string> seenKeys)
        {
            if (planned == null)
            {
                return null;
            }

            if (seenKeys == null)
            {
                return planned.Clone();
            }

            var salt = sampleIndex * 17 + roundSalt;
            if (!seenKeys.Contains(planned.ToKey()))
            {
                return planned.Clone();
            }

            var unique = BlastMultiTierPhase1AdaptiveSampler.EnsureUniqueCandidate(_config, planned, seenKeys, salt);
            if (unique != null)
            {
                return unique;
            }

            var lhsSamples = GenerateLhsSamples(1, sampleIndex + roundSalt);
            if (lhsSamples == null || lhsSamples.Count == 0)
            {
                return null;
            }

            return BlastMultiTierPhase1AdaptiveSampler.EnsureUniqueCandidate(
                _config,
                lhsSamples[0],
                seenKeys,
                salt + 1000);
        }

        private CandidateEvaluation RunPhase1MandatorySample(
            ParameterCandidate plannedCandidate,
            int sampleIndex,
            int roundSalt,
            string evalScope,
            string progressLabel,
            float progressBase,
            float progressSpan,
            HashSet<string> phase1SeenKeys)
        {
            var candidate = ResolveUniquePhase1MandatoryCandidate(
                plannedCandidate,
                sampleIndex,
                roundSalt,
                phase1SeenKeys);
            if (candidate == null)
            {
                Debug.LogWarning("[MultiTierOptimizer] Phase1 mandatory 无法解析唯一配置，跳过样本 index="
                                 + sampleIndex);
                return null;
            }

            var seedOffset = GetPhase1SeedOffset();
            var eval = RunEvaluation(
                candidate,
                _config.phase1Runs,
                seedOffset,
                evalScope,
                progressLabel,
                progressBase,
                progressSpan);
            if (eval == null)
            {
                return null;
            }

            eval.sourcePhase = "p1";
            phase1SeenKeys?.Add(candidate.ToKey());
            return eval;
        }

        private List<ParameterCandidate> GenerateLhsSamples(int count, int globalIndexOffset = 0)
        {
            var samples = new List<ParameterCandidate>(count);
            var ratioDim = RatioSlotCount;
            var totalStrata = Mathf.Max(1, globalIndexOffset + count);

            for (var i = 0; i < count; i++)
            {
                var g = globalIndexOffset + i;
                var rng = CreateDerivedRandom(11003, g);
                var candidate = BlastMultiTierPhase1AdaptiveSampler.CreateFixedCandidate(
                    _config,
                    null,
                    MapLhs(rng, g, totalStrata, _config.startDifficultyMin, _config.startDifficultyMax));
                candidate.startDifficulty =
                    MapLhs(rng, g, totalStrata, _config.startDifficultyMin, _config.startDifficultyMax);

                for (var r = 0; r < ratioDim; r++)
                    candidate.ratios[r] = MapLhs(rng, (g + 59 + r * 13) % totalStrata, totalStrata,
                        _config.ratioMin, _config.ratioMax);

                samples.Add(candidate);
            }

            return samples;
        }

        private enum Phase1WinRateSamplingDirection
        {
            TowardCenter,
            TowardLower,
            TowardHigher
        }

        private sealed class Phase1ExtensionFocus
        {
            public float bandHigh;
            public float bandLow;
            public float configuredWinRate;
            public int deficit;
            public Phase1WinRateSamplingDirection direction;
            public float samplingTargetWinRate;
            public string tierName;
        }

        private sealed class Phase1TargetTrack
        {
            public ParameterCandidate currentCandidate;
            public Phase1WinRateSamplingDirection direction;
            public float lastObservedWinRate;
            public int parentTrackIndex;
            public int stepIndex;
            public float targetWinRate;
        }

        /// <summary>Phase0 该档现配已满足时，不参与 Phase1 可达硬门与扩展定向。</summary>
        private bool IsPhase0PriorSatisfiedAt(int tierIndex)
        {
            return _priorSatisfied != null
                   && tierIndex >= 0
                   && tierIndex < _priorSatisfied.Length
                   && _priorSatisfied[tierIndex];
        }

        private bool TryResolvePhase1ExtensionFocus(
            IList<CandidateEvaluation> evals,
            out Phase1ExtensionFocus focus)
        {
            focus = null;
            if (_config.tiers == null || evals == null || evals.Count == 0)
                return false;

            var margin = Mathf.Max(0f, _config.phase1WinRateMargin);
            var required = ResolvePhase1SoftFillTarget();
            TierTarget deficitTier = null;
            var worstDeficit = 0;
            var worstConfigured = 0f;
            var worstInBand = 0;

            for (var i = 0; i < _config.tiers.Count; i++)
            {
                var tier = _config.tiers[i];
                if (tier == null) continue;
                if (IsPhase0PriorSatisfiedAt(i)) continue;

                var configured = ResolveConfiguredTargetWinRate(tier);
                var inBand = CountUniquePhase1OverlapCandidates(evals, configured);
                if (inBand >= required) continue;

                var deficit = required - inBand;
                if (deficit <= worstDeficit) continue;

                worstDeficit = deficit;
                deficitTier = tier;
                worstConfigured = configured;
                worstInBand = inBand;
            }

            if (deficitTier == null || worstDeficit <= 0)
                return false;

            var bandLow = Mathf.Clamp01(worstConfigured - margin);
            var bandHigh = Mathf.Clamp01(worstConfigured + margin);
            var belowLow = 0;
            var aboveHigh = 0;
            for (var i = 0; i < evals.Count; i++)
            {
                var eval = evals[i];
                if (eval == null) continue;
                var winRate = Mathf.Clamp01(eval.winRate);
                if (winRate + 0.0001f < bandLow) belowLow++;
                else if (winRate > bandHigh + 0.0001f) aboveHigh++;
            }

            Phase1WinRateSamplingDirection direction;
            if (worstInBand > 0)
            {
                direction = Phase1WinRateSamplingDirection.TowardCenter;
            }
            else if (aboveHigh > 0 && belowLow == 0)
            {
                direction = Phase1WinRateSamplingDirection.TowardLower;
            }
            else if (belowLow > 0 && aboveHigh == 0)
            {
                direction = Phase1WinRateSamplingDirection.TowardHigher;
            }
            else if (aboveHigh > belowLow)
            {
                direction = Phase1WinRateSamplingDirection.TowardLower;
            }
            else if (belowLow > aboveHigh)
            {
                direction = Phase1WinRateSamplingDirection.TowardHigher;
            }
            else
            {
                direction = Phase1WinRateSamplingDirection.TowardCenter;
            }

            focus = new Phase1ExtensionFocus
            {
                tierName = deficitTier.name,
                configuredWinRate = worstConfigured,
                bandLow = bandLow,
                bandHigh = bandHigh,
                deficit = worstDeficit,
                direction = direction,
                samplingTargetWinRate = worstConfigured
            };
            return true;
        }

        private static CandidateEvaluation SelectPhase1ExtensionSeed(
            IList<CandidateEvaluation> valid,
            Phase1WinRateSamplingDirection direction,
            float target)
        {
            switch (direction)
            {
                case Phase1WinRateSamplingDirection.TowardHigher:
                {
                    var below = valid
                        .Where(candidate => candidate.winRate + 0.0001f < target)
                        .OrderByDescending(candidate => candidate.winRate)
                        .FirstOrDefault();
                    return below ?? valid.OrderByDescending(candidate => candidate.winRate).First();
                }
                case Phase1WinRateSamplingDirection.TowardLower:
                {
                    var above = valid
                        .Where(candidate => candidate.winRate > target + 0.0001f)
                        .OrderBy(candidate => candidate.winRate)
                        .FirstOrDefault();
                    return above ?? valid.OrderBy(candidate => candidate.winRate).First();
                }
                default:
                    return valid.OrderBy(candidate => Math.Abs(candidate.winRate - target)).First();
            }
        }

        private static CandidateEvaluation SelectPhase1ExtensionPole(
            IList<CandidateEvaluation> valid,
            Phase1WinRateSamplingDirection direction,
            float target,
            CandidateEvaluation seed)
        {
            switch (direction)
            {
                case Phase1WinRateSamplingDirection.TowardHigher:
                {
                    var ordered = valid.OrderByDescending(candidate => candidate.winRate).ToList();
                    if (ordered.Count == 0) return seed;
                    return ordered[0] == seed && ordered.Count > 1 ? ordered[1] : ordered[0];
                }
                case Phase1WinRateSamplingDirection.TowardLower:
                {
                    var ordered = valid.OrderBy(candidate => candidate.winRate).ToList();
                    if (ordered.Count == 0) return seed;
                    return ordered[0] == seed && ordered.Count > 1 ? ordered[1] : ordered[0];
                }
                default:
                {
                    if (seed != null && seed.winRate + 0.0001f < target)
                    {
                        var above = valid
                            .Where(candidate => candidate.winRate > target + 0.0001f)
                            .OrderBy(candidate => candidate.winRate)
                            .FirstOrDefault();
                        if (above != null) return above;
                    }
                    else if (seed != null && seed.winRate > target + 0.0001f)
                    {
                        var below = valid
                            .Where(candidate => candidate.winRate + 0.0001f < target)
                            .OrderByDescending(candidate => candidate.winRate)
                            .FirstOrDefault();
                        if (below != null) return below;
                    }

                    return valid.OrderByDescending(candidate => candidate.winRate).First();
                }
            }
        }

        private List<ParameterCandidate> GenerateTargetedPhase1ExtensionSamples(
            int count,
            IList<CandidateEvaluation> evals,
            int globalIndexOffset,
            out string focusLog)
        {
            focusLog = null;
            if (count <= 0)
                return new List<ParameterCandidate>();

            if (!TryResolvePhase1ExtensionFocus(evals, out var focus))
                return GeneratePhase1ExtensionFallbackSamples(evals, count, globalIndexOffset);

            var valid = evals.Where(candidate => candidate != null && candidate.candidate != null).ToList();
            if (valid.Count == 0)
                return GeneratePhase1ExtensionFallbackSamples(evals, count, globalIndexOffset);

            var target = focus.samplingTargetWinRate;
            var targetText = target.ToString("P0", CultureInfo.InvariantCulture);
            var directionText = focus.direction switch
            {
                Phase1WinRateSamplingDirection.TowardLower => "补低胜率",
                Phase1WinRateSamplingDirection.TowardHigher => "补高胜率",
                _ => "补目标带"
            };
            focusLog = focus.tierName + " " + targetText + " " + directionText;

            var seedEval = SelectPhase1ExtensionSeed(valid, focus.direction, target);
            var poleEval = SelectPhase1ExtensionPole(valid, focus.direction, target, seedEval);

            var existingKeys = new HashSet<string>(valid.Select(candidate => candidate.candidate.ToKey()));
            var samples = new List<ParameterCandidate>(count);

            for (var i = 0; i < count; i++)
            {
                var extensionOrdinal = globalIndexOffset + i;
                var jitter = CreateDerivedRandom(31007, extensionOrdinal);
                var blendT = Mathf.Clamp01(0.18f + extensionOrdinal * 0.035f);
                var candidate = seedEval.candidate.Clone();
                if (poleEval?.candidate != null && seedEval?.candidate != null && poleEval != seedEval)
                    BlendParameterCandidates(candidate, seedEval.candidate, poleEval.candidate, blendT);

                ApplyPhase1ExtensionDirectedNudge(candidate, focus.direction, extensionOrdinal, jitter);

                var attempts = 0;
                while (existingKeys.Contains(candidate.ToKey()) && attempts < 8)
                {
                    ApplyPhase1ExtensionDirectedNudge(
                        candidate,
                        focus.direction,
                        extensionOrdinal + attempts + 1,
                        CreateDerivedRandom(31007, extensionOrdinal * 17 + attempts + 1));
                    attempts++;
                }

                existingKeys.Add(candidate.ToKey());
                samples.Add(candidate);
            }

            return samples;
        }

        private void BlendParameterCandidates(
            ParameterCandidate dst,
            ParameterCandidate from,
            ParameterCandidate to,
            float t)
        {
            dst.startDifficulty = Mathf.Clamp(
                Mathf.RoundToInt(Mathf.Lerp(from.startDifficulty, to.startDifficulty, t)),
                _config.startDifficultyMin,
                _config.startDifficultyMax);
            dst.shuffleSplitCount = Mathf.Clamp(
                _config.phase1FixedShuffleSplitCount,
                _config.shuffleSplitCountMin,
                _config.shuffleSplitCountMax);
            dst.overflowFactor = Mathf.Clamp(
                _config.phase1FixedOverflowFactor,
                _config.overflowFactorMin,
                _config.overflowFactorMax);

            if (from.ratios == null || to.ratios == null || dst.ratios == null)
                return;

            var len = Mathf.Min(dst.ratios.Length, Mathf.Min(from.ratios.Length, to.ratios.Length));
            for (var i = 0; i < len; i++)
                dst.ratios[i] = Mathf.Clamp(
                    Mathf.RoundToInt(Mathf.Lerp(from.ratios[i], to.ratios[i], t)),
                    _config.ratioMin,
                    _config.ratioMax);
        }

        /// <summary>
        ///     按 bot_optimization 参数→胜率关系做定向微调（保留目标方向；slot/微步由派生 RNG 选择）。
        ///     split/overflow 已固定，扩展阶段仅继续微调 startDifficulty 与 ratio。
        /// </summary>
        private void ApplyPhase1ExtensionDirectedNudge(
            ParameterCandidate candidate,
            Phase1WinRateSamplingDirection direction,
            int salt,
            Random jitter = null)
        {
            if (candidate == null) return;

            jitter ??= CreateDerivedRandom(31011, salt);
            var step = 1 + jitter.Next(0, 2);
            switch (direction)
            {
                case Phase1WinRateSamplingDirection.TowardHigher:
                    candidate.startDifficulty = Mathf.Clamp(
                        candidate.startDifficulty - step,
                        _config.startDifficultyMin,
                        _config.startDifficultyMax);
                    candidate.shuffleSplitCount = Mathf.Clamp(
                        _config.phase1FixedShuffleSplitCount,
                        _config.shuffleSplitCountMin,
                        _config.shuffleSplitCountMax);
                    candidate.overflowFactor = Mathf.Clamp(
                        _config.phase1FixedOverflowFactor,
                        _config.overflowFactorMin,
                        _config.overflowFactorMax);
                    if (candidate.ratios != null && candidate.ratios.Length > 0)
                    {
                        var slot = jitter.Next(0, candidate.ratios.Length);
                        candidate.ratios[slot] = Mathf.Clamp(
                            candidate.ratios[slot] - 1,
                            _config.ratioMin,
                            _config.ratioMax);
                    }

                    break;
                case Phase1WinRateSamplingDirection.TowardLower:
                    candidate.startDifficulty = Mathf.Clamp(
                        candidate.startDifficulty + step,
                        _config.startDifficultyMin,
                        _config.startDifficultyMax);
                    candidate.shuffleSplitCount = Mathf.Clamp(
                        _config.phase1FixedShuffleSplitCount,
                        _config.shuffleSplitCountMin,
                        _config.shuffleSplitCountMax);
                    candidate.overflowFactor = Mathf.Clamp(
                        _config.phase1FixedOverflowFactor,
                        _config.overflowFactorMin,
                        _config.overflowFactorMax);
                    if (candidate.ratios != null && candidate.ratios.Length > 0)
                    {
                        var slot = jitter.Next(0, candidate.ratios.Length);
                        candidate.ratios[slot] = Mathf.Clamp(
                            candidate.ratios[slot] + 1,
                            _config.ratioMin,
                            _config.ratioMax);
                    }

                    break;
                default:
                {
                    var towardHigher = jitter.Next(0, 2) == 0;
                    var sdStep = towardHigher ? -1 : 1;
                    candidate.startDifficulty = Mathf.Clamp(
                        candidate.startDifficulty + sdStep,
                        _config.startDifficultyMin,
                        _config.startDifficultyMax);
                    candidate.shuffleSplitCount = Mathf.Clamp(
                        _config.phase1FixedShuffleSplitCount,
                        _config.shuffleSplitCountMin,
                        _config.shuffleSplitCountMax);
                    candidate.overflowFactor = Mathf.Clamp(
                        _config.phase1FixedOverflowFactor,
                        _config.overflowFactorMin,
                        _config.overflowFactorMax);
                    if (candidate.ratios != null && candidate.ratios.Length > 0)
                    {
                        var slot = jitter.Next(0, candidate.ratios.Length);
                        candidate.ratios[slot] = Mathf.Clamp(
                            candidate.ratios[slot] + (towardHigher ? -1 : 1),
                            _config.ratioMin,
                            _config.ratioMax);
                    }

                    break;
                }
            }
        }

        private static int MapLhs(Random rng, int stratum, int total, int min, int max)
        {
            var range = max - min;
            if (range <= 0) return min;
            var frac = (stratum + rng.NextDouble()) / total;
            return min + Mathf.Clamp(Mathf.RoundToInt((float) (min + frac * range)), min, max);
        }

        private static float MapLhsFloat(Random rng, int stratum, int total, float min, float max)
        {
            var frac = (stratum + rng.NextDouble()) / total;
            return Mathf.Clamp(min + (float) frac * (max - min), min, max);
        }

        private CandidateEvaluation RunEvaluation(
            ParameterCandidate candidate,
            int runCount,
            int seedOffset,
            string evalScope,
            string progressPrefix,
            float progressBase,
            float progressSpan,
            int? forcedDynamicTier = null,
            bool applyCandidateToStack = true,
            float? bayesStdThresholdOverride = null,
            int priorWins = 0,
            int priorLosses = 0)
        {
            var stdThreshold = bayesStdThresholdOverride ?? ResolveBayesStdThresholdFromEvalScope(evalScope);
            var tierTag = forcedDynamicTier.HasValue ? "|ft" + forcedDynamicTier.Value : "";
            var applyTag = applyCandidateToStack ? "|apply" : "|raw";
            var priorTag = "|pw" + Mathf.Max(0, priorWins) + "|pl" + Mathf.Max(0, priorLosses);
            var seedTag = "|so" + seedOffset;
            var thrTag = "|thr" + stdThreshold.ToString("0.0000", CultureInfo.InvariantCulture);
            // Cache identity excludes target/failDist (post-score only).
            var cacheKey = candidate.ToKey() + "|n" + runCount + "|" + evalScope + seedTag + tierTag + applyTag
                           + priorTag + thrTag;
            if (_evalCache.TryGetValue(cacheKey, out var cached))
            {
                ReportProgress($"{progressPrefix}, current {runCount}/{runCount} runs (cached)",
                    progressBase + progressSpan);
                return cached;
            }

            var simLevel = Object.Instantiate(_level);
            CandidateEvaluation result;

            try
            {
                var simStack = simLevel.Stack;
                var splitCount = Mathf.Max(1, candidate != null ? candidate.shuffleSplitCount : 1);
                if (applyCandidateToStack && candidate != null)
                    ApplyCandidateToNeutralTierConfig(simStack, candidate, splitCount);

                var maxSteps = BlastBotService.GetDefaultMaxStepsFromHumanConfig();
                var baseSeed = BlastBotRunPolicy.BuildSeedBase(_config.gameLevel);
                var options = BlastBotRunPolicy.CreateSingleRunOptions(simLevel, _config.gameLevel, baseSeed,
                    maxSteps, _config.preferBfsRawQueue, _config.strategy);
                if (forcedDynamicTier.HasValue)
                    options.forcedDynamicTier = forcedDynamicTier.Value;
                var template = BlastBotService.BuildInitialSimulationTemplate(simLevel, options);

                var useBayesian = _config.bayesAdaptiveStopEnabled && runCount >= _config.bayesBatchSize;

                if (useBayesian)
                {
                    result = RunEvaluationBayesianAdaptive(
                        candidate, runCount, seedOffset, evalScope, progressPrefix, progressBase, progressSpan,
                        simLevel, template, maxSteps, forcedDynamicTier, stdThreshold, priorWins, priorLosses);
                }
                else
                {
                    var workerCount = BlastBotRunPolicy.ResolveEffectiveWorkerCount(_config.maxWorkers, runCount);
                    var pollWaitMs = BlastBotRunPolicy.ResolveBatchPollWaitMs(workerCount);
                    var evalSeed = baseSeed + seedOffset;

                    var batchOptions = BlastBotRunPolicy.CreateSingleRunOptions(simLevel, _config.gameLevel, evalSeed,
                        maxSteps, _config.preferBfsRawQueue, _config.strategy);
                    if (forcedDynamicTier.HasValue)
                        batchOptions.forcedDynamicTier = forcedDynamicTier.Value;
                    batchOptions.runCount = runCount;
                    batchOptions.CachedMergeSimContext = options.CachedMergeSimContext;

                    var runs = BlastBotRunPolicy.RunSingleBatchParallel(simLevel, batchOptions, template,
                        _config.gameLevel, runCount, workerCount, evalSeed,
                        done =>
                        {
                            var safeDone = Mathf.Clamp(done, 0, runCount);
                            var runPct = runCount > 0 ? safeDone / (float) runCount : 1f;
                            ReportProgress($"{progressPrefix}, current {safeDone}/{runCount} runs",
                                progressBase + progressSpan * runPct);
                            return IsCancelled();
                        },
                        false, false, pollWaitMs, out var cancelled);
                    if (cancelled)
                        return null;

                    var winCount = 0;
                    var failBins = new int[_config.failBinCount];
                    var failCount = 0;

                    if (runs != null)
                        for (var ri = 0; ri < runs.Length; ri++)
                        {
                            var run = runs[ri];
                            if (run == null) continue;
                            if (run.won)
                            {
                                winCount++;
                            }
                            else
                            {
                                failCount++;
                                var targetTotal = Mathf.Max(0, run.initialTargetUnitTotal);
                                var cleared = Mathf.Max(0, targetTotal - Mathf.Max(0, run.finalTargetUnitRemaining));
                                var progress = targetTotal > 0 ? (float) cleared / targetTotal : 0f;
                                var bin = Mathf.Clamp((int) (progress * _config.failBinCount), 0,
                                    _config.failBinCount - 1);
                                failBins[bin]++;
                            }
                        }

                    var wr = runCount > 0 ? (float) winCount / runCount : 0f;
                    var n = Math.Max(1, runCount);
                    var se = Mathf.Sqrt(wr * (1f - wr) / n);

                    float alpha = _config.bayesPriorAlpha + priorWins + winCount;
                    float beta = _config.bayesPriorBeta + priorLosses + failCount;
                    float total = alpha + beta;
                    float posteriorVar = (alpha * beta) / (total * total * (total + 1));
                    float posteriorStd = (float)Math.Sqrt(posteriorVar);

                    result = new CandidateEvaluation
                    {
                        candidate = candidate.Clone(),
                        winCount = winCount,
                        winRate = wr,
                        failCount = failCount,
                        failBins = failBins,
                        totalRuns = runCount,
                        plannedRuns = runCount,
                        posteriorStd = posteriorStd,
                        stopReason = "full",
                        stdErr = se
                    };
                }
            }
            finally
            {
                if (simLevel != null)
                    Object.DestroyImmediate(simLevel);
            }

            if (result == null)
                return null;

            _evalCache[cacheKey] = result;

            _cumulativeRuns += result.totalRuns;
            var wrPct = (result.winRate * 100f).ToString("F1");
            Debug.Log(
                $"[MultiTierOpt] Cumulative {_cumulativeRuns} runs completed, latest batch +{result.totalRuns} wr={wrPct}%, phase={progressPrefix}");

            return result;
        }

        /// <summary>
        /// 按 evalScope 前缀解析分 Phase 后验阈值（p0/p1/p2/p3）。
        /// </summary>
        private float ResolveBayesStdThresholdFromEvalScope(string evalScope)
        {
            if (string.IsNullOrEmpty(evalScope))
            {
                return _config.bayesStdThreshold;
            }

            if (evalScope.StartsWith("p0", StringComparison.Ordinal))
            {
                return _config.ResolveBayesStdThreshold(0);
            }

            if (evalScope.StartsWith("p1", StringComparison.Ordinal))
            {
                return _config.ResolveBayesStdThreshold(1);
            }

            if (evalScope.StartsWith("p2", StringComparison.Ordinal))
            {
                return _config.ResolveBayesStdThreshold(2);
            }

            if (evalScope.StartsWith("p3", StringComparison.Ordinal))
            {
                return _config.ResolveBayesStdThreshold(3);
            }

            return _config.bayesStdThreshold;
        }

        /// <summary>
        /// 贝叶斯自适应停止：同一组 LongRunning worker 跨波次复用，每波后用 prior+本段累计后验判定早停。
        /// </summary>
        private CandidateEvaluation RunEvaluationBayesianAdaptive(
            ParameterCandidate candidate,
            int plannedRuns,
            int seedOffset,
            string evalScope,
            string progressPrefix,
            float progressBase,
            float progressSpan,
            LevelProfileConfig simLevel,
            BlastBotService.BlastBotInitialSimulationTemplate template,
            int maxSteps,
            int? forcedDynamicTier,
            float stdThreshold,
            int priorWins,
            int priorLosses)
        {
            var baseSeed = BlastBotRunPolicy.BuildSeedBase(_config.gameLevel);
            var evalSeed = baseSeed + seedOffset;
            var waveSize = Mathf.Max(1, _config.bayesBatchSize);
            var workerCount = BlastBotRunPolicy.ResolveEffectiveWorkerCount(_config.maxWorkers, plannedRuns);
            var pollWaitMs = BlastBotRunPolicy.ResolveBatchPollWaitMs(workerCount);
            var safeThreshold = Mathf.Max(0f, stdThreshold);

            var batchOptions = BlastBotRunPolicy.CreateSingleRunOptions(simLevel, _config.gameLevel, evalSeed,
                maxSteps, _config.preferBfsRawQueue, _config.strategy);
            if (forcedDynamicTier.HasValue)
                batchOptions.forcedDynamicTier = forcedDynamicTier.Value;
            batchOptions.runCount = plannedRuns;
            if (template != null)
                BlastBotRunPolicy.EnsureMergeSimContextCached(batchOptions);

            var runs = BlastBotRunPolicy.RunSingleBatchParallelWaved(
                simLevel, batchOptions, template, _config.gameLevel, plannedRuns, workerCount, evalSeed,
                done =>
                {
                    float progressPct = plannedRuns > 0 ? (float)done / plannedRuns : 1f;
                    ReportProgress($"{progressPrefix}, adaptive {done}/{plannedRuns} runs",
                        progressBase + progressSpan * progressPct);
                    return IsCancelled();
                },
                waveSize,
                (results, completed) =>
                {
                    CountWinsLosses(results, completed, out var wins, out var losses, null);
                    float alpha = _config.bayesPriorAlpha + priorWins + wins;
                    float beta = _config.bayesPriorBeta + priorLosses + losses;
                    float total = alpha + beta;
                    float posteriorVar = (alpha * beta) / (total * total * (total + 1));
                    float posteriorStd = (float)Math.Sqrt(posteriorVar);
                    return posteriorStd < safeThreshold && completed >= waveSize;
                },
                false, false, pollWaitMs, out var cancelled, out var earlyStopped);
            if (cancelled)
                return null;

            var failBins = new int[_config.failBinCount];
            CountWinsLosses(runs, plannedRuns, out var segmentWins, out var segmentLosses, failBins);
            var totalDone = segmentWins + segmentLosses;
            var wr = totalDone > 0 ? (float)segmentWins / totalDone : 0f;
            var n = Math.Max(1, totalDone);
            var se = Mathf.Sqrt(wr * (1f - wr) / n);

            float alphaFinal = _config.bayesPriorAlpha + priorWins + segmentWins;
            float betaFinal = _config.bayesPriorBeta + priorLosses + segmentLosses;
            float totalFinal = alphaFinal + betaFinal;
            float posteriorVarFinal = (alphaFinal * betaFinal) / (totalFinal * totalFinal * (totalFinal + 1));
            float posteriorStdFinal = (float)Math.Sqrt(posteriorVarFinal);

            return new CandidateEvaluation
            {
                candidate = candidate.Clone(),
                winCount = segmentWins,
                winRate = wr,
                failCount = segmentLosses,
                failBins = failBins,
                totalRuns = totalDone,
                plannedRuns = plannedRuns,
                stdErr = se,
                posteriorStd = posteriorStdFinal,
                stopReason = earlyStopped ? "early:threshold" : "full"
            };
        }

        private void CountWinsLosses(
            BlastBotRunResult[] runs,
            int maxCount,
            out int wins,
            out int losses,
            int[] failBinsOrNull)
        {
            wins = 0;
            losses = 0;
            if (runs == null)
                return;

            var limit = Math.Min(maxCount, runs.Length);
            for (var ri = 0; ri < limit; ri++)
            {
                var run = runs[ri];
                if (run == null)
                    continue;
                if (run.won)
                {
                    wins++;
                    continue;
                }

                losses++;
                if (failBinsOrNull == null || failBinsOrNull.Length <= 0)
                    continue;

                var targetTotal = Mathf.Max(0, run.initialTargetUnitTotal);
                var cleared = Mathf.Max(0, targetTotal - Mathf.Max(0, run.finalTargetUnitRemaining));
                var progress = targetTotal > 0 ? (float)cleared / targetTotal : 0f;
                var bin = Mathf.Clamp((int)(progress * failBinsOrNull.Length), 0, failBinsOrNull.Length - 1);
                failBinsOrNull[bin]++;
            }
        }

        private void ApplyCandidateToNeutralTierConfig(
            MyStack stack,
            ParameterCandidate candidate,
            int splitCount)
        {
            if (stack == null || candidate == null)
            {
                return;
            }

            var tierConfig = BuildCandidateDynamicDifficultyConfig(candidate, splitCount);
            if (stack.DynamicDifficultyConfigs == null)
            {
                stack.DynamicDifficultyConfigs = new List<MyStack.DynamicDifficultyConfig>(5);
            }

            while (stack.DynamicDifficultyConfigs.Count < 5)
            {
                stack.DynamicDifficultyConfigs.Add(CloneDynamicDifficultyConfig(tierConfig));
            }

            var neutralIndex = ResolveNeutralTierIndex();
            stack.DynamicDifficultyConfigs[neutralIndex] = tierConfig;
        }

        private static MyStack.DynamicDifficultyConfig BuildCandidateDynamicDifficultyConfig(
            ParameterCandidate candidate,
            int splitCount)
        {
            return new MyStack.DynamicDifficultyConfig
            {
                StartDifficulty = candidate.startDifficulty,
                ShuffleSplitCount = splitCount,
                ShuffleSplitRatios = candidate.RatiosToCsvForSplitCount(splitCount),
                ShuffleOverflowFactor = candidate.overflowFactor
            };
        }

        private static MyStack.DynamicDifficultyConfig CloneDynamicDifficultyConfig(
            MyStack.DynamicDifficultyConfig source)
        {
            if (source == null)
                return null;

            return new MyStack.DynamicDifficultyConfig
            {
                StartDifficulty = source.StartDifficulty,
                ShuffleSplitCount = source.ShuffleSplitCount,
                ShuffleSplitRatios = source.ShuffleSplitRatios,
                ShuffleOverflowFactor = source.ShuffleOverflowFactor
            };
        }

        private void ReportProgress(string message, float pct)
        {
            _progressReporter?.Invoke(message, Mathf.Clamp01(pct));
        }

        private bool IsCancelled()
        {
            return _cancelRequested != null && _cancelRequested();
        }

        private void UpdateCompositeScore(CandidateEvaluation eval, TierTarget target)
        {
            var configuredTarget = target.configuredTargetWinRate > 0f
                ? target.configuredTargetWinRate
                : target.targetWinRate;
            eval.configuredTargetWinRate = configuredTarget;
            eval.effectiveTargetWinRate = target.targetWinRate;
            eval.targetClamped = target.targetClamped;
            eval.reachableMinWinRate = target.reachableMinWinRate;
            eval.reachableMaxWinRate = target.reachableMaxWinRate;
            // outOfTargetMargin is owned by stage/final gates — do not clear here.
            eval.failDistScore =
                ComputeFailDistributionDistanceScore(eval.failBins, eval.failCount, target.targetFailDistribution);

            var w1 = _config.weightWinRate;
            var w2 = _config.weightFailDistribution;
            // FailDist reliability: full weight at failBinCount*3 fails; missing weight shifts to winRate.
            var failFullWeightSamples = Mathf.Max(1, _config.failBinCount * 3);
            var failReliability = eval.failCount <= 0
                ? 0f
                : Mathf.Clamp01(eval.failCount / (float) failFullWeightSamples);
            var effectiveW2 = w2 * failReliability;
            w1 += w2 - effectiveW2;
            w2 = effectiveW2;

            eval.winRateMatch = ComputeWinRateMatchScore(eval.winRate, target);

            var savedW1 = _config.weightWinRate;
            var savedW2 = _config.weightFailDistribution;
            _config.weightWinRate = w1;
            _config.weightFailDistribution = w2;
            eval.compositeScore = ComputeCompositeScore(eval.winRate, eval.failDistScore, target);
            _config.weightWinRate = savedW1;
            _config.weightFailDistribution = savedW2;
        }

        private CandidateEvaluation MergeEvaluations(CandidateEvaluation a, CandidateEvaluation b)
        {
            var totalWins = a.winCount + b.winCount;
            var mergedFailCount = a.failCount + b.failCount;
            var totalRuns = totalWins + mergedFailCount;
            if (totalRuns <= 0)
            {
                totalRuns = a.totalRuns + b.totalRuns;
            }

            var wr = totalRuns > 0 ? (float) totalWins / totalRuns : 0f;

            var mergedBins = new int[_config.failBinCount];
            if (a.failBins != null)
            {
                for (var i = 0; i < Math.Min(a.failBins.Length, _config.failBinCount); i++)
                {
                    mergedBins[i] += a.failBins[i];
                }
            }

            if (b.failBins != null)
            {
                for (var i = 0; i < Math.Min(b.failBins.Length, _config.failBinCount); i++)
                {
                    mergedBins[i] += b.failBins[i];
                }
            }

            var n = Math.Max(1, totalRuns);
            var se = Mathf.Sqrt(wr * (1f - wr) / n);

            float alpha = _config.bayesPriorAlpha + totalWins;
            float beta = _config.bayesPriorBeta + mergedFailCount;
            float totalAb = alpha + beta;
            float posteriorVar = totalAb > 0f
                ? (alpha * beta) / (totalAb * totalAb * (totalAb + 1f))
                : 0f;
            float posteriorStd = (float) Math.Sqrt(Math.Max(0f, posteriorVar));

            return new CandidateEvaluation
            {
                candidate = a.candidate ?? b.candidate,
                winCount = totalWins,
                winRate = wr,
                failCount = mergedFailCount,
                failBins = mergedBins,
                totalRuns = totalRuns,
                plannedRuns = a.plannedRuns + b.plannedRuns,
                Phase2Appended = a.Phase2Appended || b.Phase2Appended,
                stdErr = se,
                posteriorStd = posteriorStd,
                stopReason = !string.IsNullOrEmpty(b.stopReason) ? b.stopReason : a.stopReason,
                sourcePhase = !string.IsNullOrEmpty(b.sourcePhase) ? b.sourcePhase : a.sourcePhase,
                status = !string.IsNullOrEmpty(b.status) ? b.status : a.status,
                failureReason = !string.IsNullOrEmpty(b.failureReason) ? b.failureReason : a.failureReason,
                phase1SampleKind = a.phase1SampleKind ?? b.phase1SampleKind
            };
        }

        private float ComputeCompositeScore(float winRate, float failDistScore, TierTarget target)
        {
            var winRateMatch = ComputeWinRateMatchScore(winRate, target);

            var w1 = _config.weightWinRate;
            var w2 = _config.weightFailDistribution;
            var sum = w1 + w2;
            if (sum <= 0f)
            {
                w1 = 1f;
                w2 = 0f;
                sum = 1f;
            }

            return (w1 * winRateMatch + w2 * failDistScore) / sum;
        }

        private float ComputeWinRateMatchScore(float winRate, TierTarget target)
        {
            if (target == null)
            {
                return 0f;
            }

            // Final / composite scoring uses configured target (not effective/clamped).
            var configured = ResolveConfiguredTargetWinRate(target);
            var targetGap = Mathf.Abs(winRate - configured);
            var targetBand = Mathf.Max(0.01f, FinalHardGap);
            return Mathf.Clamp01(1f - targetGap / targetBand);
        }

        private static float ComputeFailDistributionDistanceScore(int[] failBins, int failCount,
            List<float> targetDistribution)
        {
            var size = Mathf.Max(1, targetDistribution?.Count ?? 0);
            if (failBins == null) return 0f;

            var totalDistance = 0f;
            for (var i = 0; i < size; i++)
            {
                var actual = failCount > 0 ? failBins[i] / (float) failCount : 0f;
                var tgt = targetDistribution != null && i < targetDistribution.Count
                    ? Mathf.Max(0f, targetDistribution[i])
                    : 0f;
                totalDistance += Mathf.Abs(actual - tgt);
            }

            return Mathf.Max(0f, 1f - totalDistance / 2f);
        }

        private static float ResolveConfiguredTargetWinRate(TierTarget tier)
        {
            if (tier == null) return 0f;
            return tier.configuredTargetWinRate > 0f ? tier.configuredTargetWinRate : tier.targetWinRate;
        }

        private int CountUniquePhase1OverlapCandidates(IList<CandidateEvaluation> evals, float configured)
        {
            return CountUniqueConfigsPassingStageGate(evals, configured, Phase1AbsoluteCap);
        }

        private bool IsConfiguredTierHardMinimumSatisfied(TierTarget tier, IList<CandidateEvaluation> evals,
            out string reason)
        {
            reason = null;
            if (tier == null) return true;

            var configured = ResolveConfiguredTargetWinRate(tier);
            var configuredText = configured.ToString("P0", CultureInfo.InvariantCulture);
            var required = ResolveStageHardMinCandidates();
            var count = CountUniquePhase1OverlapCandidates(evals, configured);
            if (count >= required) return true;

            reason = "Phase1 档位 " + tier.name + " 交叠门内唯一候选仅 " + count
                     + " 个(需要至少 " + required + " 个，目标 " + configuredText
                     + "，soft=" + SoftOverlapGap.ToString("P0", CultureInfo.InvariantCulture)
                     + " absCap=" + Phase1AbsoluteCap.ToString("P0", CultureInfo.InvariantCulture)
                     + ")，已停止后续流程。";
            return false;
        }

        private bool TryValidatePhase1HardMinimum(IList<CandidateEvaluation> evals, out string reason)
        {
            reason = null;
            if (_config.tiers == null || _config.tiers.Count == 0)
            {
                reason = "Phase1 后无有效档位目标，已停止后续流程。";
                return false;
            }

            if (evals == null || evals.Count == 0)
            {
                reason = "Phase1 无有效胜率样本，已停止后续流程。";
                return false;
            }

            for (var i = 0; i < _config.tiers.Count; i++)
            {
                var tier = _config.tiers[i];
                if (tier == null) continue;
                if (IsPhase0PriorSatisfiedAt(i)) continue;
                if (IsConfiguredTierHardMinimumSatisfied(tier, evals, out reason)) continue;
                return false;
            }

            return true;
        }

        private bool IsPhase1SoftFillSatisfied(IList<CandidateEvaluation> evals)
        {
            if (_config.tiers == null || _config.tiers.Count == 0)
            {
                return false;
            }

            if (evals == null || evals.Count == 0)
            {
                return false;
            }

            var softFill = ResolvePhase1SoftFillTarget();
            for (var i = 0; i < _config.tiers.Count; i++)
            {
                var tier = _config.tiers[i];
                if (tier == null) continue;
                if (IsPhase0PriorSatisfiedAt(i)) continue;
                var configured = ResolveConfiguredTargetWinRate(tier);
                if (CountUniquePhase1OverlapCandidates(evals, configured) < softFill)
                {
                    return false;
                }
            }

            return true;
        }

        private List<CandidateEvaluation> SelectTopForTier(List<CandidateEvaluation> sortedByWinRate, TierTarget target,
            int topN)
        {
            var result = new List<CandidateEvaluation>(topN);
            if (sortedByWinRate == null || sortedByWinRate.Count == 0 || target == null || topN <= 0)
            {
                return result;
            }

            var configured = ResolveConfiguredTargetWinRate(target);
            var selectedKeys = new HashSet<string>();
            // P1: 窗口+分带覆盖，保证候选横跨目标邻域（为 P0 单调联合选档提供 WR 跨度）。
            // 分带：>=目标(上探) / 目标附近(±边缘) / <目标(下探)。优先选过 overlap gate 的核心候选，
            // 不足时放宽到窗口内候选，确保每个目标段都有覆盖而非只簇在目标附近。
            var candidates = sortedByWinRate.Where(candidate => candidate != null).ToList();
            // 预过滤：过 gate 的作为核心候选；其余作为 margin 候选（仅 winRate 硬过滤）
            var core = candidates
                .Where(c => CredibleIntervalOverlapGate(c, configured, SoftOverlapGap, Phase1AbsoluteCap, out _, out _))
                .OrderBy(c => Math.Abs(PosteriorMean(c) - configured))
                .ToList();
            var margin = candidates
                .Where(c => !CredibleIntervalOverlapGate(c, configured, SoftOverlapGap, Phase1AbsoluteCap, out _, out _))
                .Where(c => PosteriorMean(c) >= 0.05f)
                .OrderBy(c => Math.Abs(PosteriorMean(c) - configured))
                .ToList();
            // 分带：上探(>=target) / 下探(<target-边缘)
            var pool = core.Concat(margin).ToList();
            var ordered = pool
                .OrderBy(c => Math.Abs(PosteriorMean(c) - configured))
                .ToList();
            // 保证至少覆盖"下探带"（WR 明显低于目标的候选），供 P0 gap 组合
            var belowTarget = ordered.Where(c => PosteriorMean(c) < configured - 0.05f).OrderByDescending(c => PosteriorMean(c)).ToList();
            var overTarget = ordered.Where(c => PosteriorMean(c) >= configured).OrderBy(c => PosteriorMean(c)).ToList();
            foreach (var eval in ordered)
            {
                if (result.Count >= topN)
                {
                    break;
                }

                if (eval.candidate == null || !selectedKeys.Add(eval.candidate.ToKey()))
                {
                    continue;
                }

                result.Add(eval);
            }
            // 若全簇在目标附近（无下探/上探跨度），补一个下探候选避免 final 无 gap 原料
            if (result.Count < topN)
            {
                foreach (var eval in belowTarget.Concat(overTarget))
                {
                    if (result.Count >= topN)
                    {
                        break;
                    }

                    if (eval.candidate == null || !selectedKeys.Add(eval.candidate.ToKey()))
                    {
                        continue;
                    }

                    result.Add(eval);
                }
            }

            return result;
        }
        private void Shuffle<T>(IList<T> list)
        {
            var rng = CreateDerivedRandom(41013, list != null ? list.Count : 0);
            for (var i = list.Count - 1; i > 0; i--)
            {
                var j = rng.Next(i + 1);
                (list[i], list[j]) = (list[j], list[i]);
            }
        }

        private static string BuildPhase1RawCsvHeader()
        {
            return "LevelGroup,SampleKind,ConfigKey,WinRate,FailCount,TotalRuns," +
                   "StartDifficulty,ShuffleSplitCount,ShuffleSplitRatios,ShuffleOverflowFactor";
        }

        private static string FormatPhase1RawCsvLine(string levelGroup, CandidateEvaluation eval)
        {
            var sampleKind = string.IsNullOrEmpty(eval.phase1SampleKind)
                ? Phase1SampleKindMandatory
                : eval.phase1SampleKind;
            var configKey = eval.candidate != null ? eval.candidate.ToKey() : string.Empty;
            return $"{levelGroup},{sampleKind},\"{configKey}\"," +
                   $"{eval.winRate.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                   $"{eval.failCount},{eval.totalRuns}," +
                   $"{eval.candidate.startDifficulty}," +
                   $"{eval.candidate.shuffleSplitCount}," +
                   $"\"{eval.candidate.TelemetryShuffleSplitRatiosCsv()}\"," +
                   $"{eval.candidate.overflowFactor.ToString("0.000", CultureInfo.InvariantCulture)}";
        }

        private void ExportPhase1Raw(List<CandidateEvaluation> evals)
        {
            var levelGroup = ResolveExportLevelGroup(_config);
            var lines = new List<string> {BuildPhase1RawCsvHeader()};
            foreach (var eval in evals)
                lines.Add(FormatPhase1RawCsvLine(levelGroup, eval));

            File.WriteAllText(Path.Combine(_telemetryDir, "phase1_raw.csv"), string.Join("\n", lines));
            Debug.Log($"[MultiTierOptimizer] Phase1 raw exported ({evals.Count} samples)");
        }

        private void ExportPhase1ReachabilityReport(IList<CandidateEvaluation> evals)
        {
            if (_config?.tiers == null || _config.tiers.Count == 0) return;

            var hardMin = ResolveStageHardMinCandidates();
            var softFill = ResolvePhase1SoftFillTarget();
            var levelGroup = ResolveExportLevelGroup(_config);
            var lines = new List<string>
            {
                "LevelGroup,Tier,ConfiguredTargetWinRate,OverlapUniqueCount,SoftFillTarget,HardMin,SoftFillReached,PassedToPhase2,PriorSatisfied,ExtensionSamples"
            };

            for (var i = 0; i < _config.tiers.Count; i++)
            {
                var tier = _config.tiers[i];
                if (tier == null) continue;

                var priorSatisfied = IsPhase0PriorSatisfiedAt(i);
                var configured = ResolveConfiguredTargetWinRate(tier);
                var overlapUnique = CountUniquePhase1OverlapCandidates(evals, configured);
                var softFillReached = priorSatisfied || overlapUnique >= softFill;
                var passedToPhase2 = priorSatisfied || overlapUnique >= hardMin;
                lines.Add(string.Join(",",
                    levelGroup,
                    tier.name,
                    configured.ToString("0.####", CultureInfo.InvariantCulture),
                    overlapUnique.ToString(CultureInfo.InvariantCulture),
                    softFill.ToString(CultureInfo.InvariantCulture),
                    hardMin.ToString(CultureInfo.InvariantCulture),
                    softFillReached ? "true" : "false",
                    passedToPhase2 ? "true" : "false",
                    priorSatisfied ? "true" : "false",
                    _phase1ExtensionSamplesCompleted.ToString(CultureInfo.InvariantCulture)));
            }

            var reportPath = Path.Combine(_telemetryDir, "phase1_reachability.csv");
            File.WriteAllText(reportPath, string.Join("\n", lines));
            Debug.Log("[MultiTierOptimizer] Phase1 reachability report exported: " + reportPath.Replace('\\', '/'));
        }

        private void ExportRunManifest()
        {
            if (string.IsNullOrEmpty(_telemetryDir))
            {
                return;
            }

            Directory.CreateDirectory(_telemetryDir);
            var levelGroup = ResolveExportLevelGroup(_config);
            var boardFingerprint = BlastLevelFingerprintUtility.ComputeBoardFingerprint(_level);
            var sb = new StringBuilder();
            sb.AppendLine("{");
            sb.AppendLine("  \"LevelGroup\": \"" + EscapeJson(levelGroup) + "\",");
            sb.AppendLine("  \"GameLevel\": " + (_config != null ? _config.gameLevel : 0) + ",");
            sb.AppendLine("  \"FingerprintAlgorithm\": \"" +
                          BlastLevelFingerprintUtility.FingerprintAlgorithm + "\",");
            sb.AppendLine("  \"BoardFingerprint\": \"" + boardFingerprint + "\",");
            sb.AppendLine("  \"SearchSeed\": " + _searchSeed + ",");
            sb.AppendLine("  \"SeedSource\": \"" + EscapeJson(_searchSeedSource) + "\",");
            sb.AppendLine("  \"CreatedUtc\": \"" + _runCreated.ToString("o", CultureInfo.InvariantCulture) + "\",");
            sb.AppendLine("  \"BotSeedBase\": " +
                          BlastBotRunPolicy.BuildSeedBase(_config != null ? _config.gameLevel : 0) + ",");
            sb.AppendLine("  \"PhaseSeedOffsets\": {");
            sb.AppendLine("    \"p0p1\": " + GetPhase1SeedOffset() + ",");
            sb.AppendLine("    \"p2\": " + GetPhase2SeedOffset() + ",");
            sb.AppendLine("    \"p3\": " + GetPhase3SeedOffset());
            sb.AppendLine("  },");
            sb.AppendLine("  \"StageHardMin\": " + ResolveStageHardMinCandidates() + ",");
            sb.AppendLine("  \"Phase1SoftFillTarget\": " +
                          (_config != null ? ResolvePhase1SoftFillTarget() : 3) + ",");
            sb.AppendLine("  \"OutputCount\": " + (_config != null ? Mathf.Max(1, _config.outputCount) : 1) + ",");
            sb.AppendLine("  \"Phase1Samples\": " + (_config != null ? _config.phase1Samples : 0) + ",");
            sb.AppendLine("  \"Phase1Runs\": " + (_config != null ? _config.phase1Runs : 0) + ",");
            sb.AppendLine("  \"Phase2Runs\": " + (_config != null ? _config.phase2Runs : 0) + ",");
            sb.AppendLine("  \"Phase3Runs\": " + (_config != null ? _config.phase3Runs : 0) + ",");
            sb.AppendLine("  \"Phase2AdvancePerTier\": " +
                          (_config != null ? Mathf.Max(1, _config.phase2AdvancePerTier) : 1) + ",");
            sb.AppendLine("  \"Phase1FixedShuffleSplitCount\": " +
                          (_config != null ? _config.phase1FixedShuffleSplitCount : 0) + ",");
            sb.AppendLine("  \"Phase1FixedOverflowFactor\": " +
                          (_config != null
                              ? _config.phase1FixedOverflowFactor.ToString("0.###", CultureInfo.InvariantCulture)
                              : "0") + ",");
            sb.AppendLine("  \"Strategy\": \"" +
                          EscapeJson(_config != null ? _config.strategy.ToString() : string.Empty) + "\",");
            sb.Append("  \"ConfiguredTargets\": [");
            if (_config?.tiers != null)
            {
                var first = true;
                for (var i = 0; i < _config.tiers.Count; i++)
                {
                    var tier = _config.tiers[i];
                    if (tier == null) continue;
                    if (!first) sb.Append(",");
                    first = false;
                    sb.Append("{\"name\":\"").Append(EscapeJson(tier.name ?? string.Empty))
                        .Append("\",\"configuredTargetWinRate\":")
                        .Append(ResolveConfiguredTargetWinRate(tier)
                            .ToString("0.####", CultureInfo.InvariantCulture))
                        .Append("}");
                }
            }

            sb.AppendLine("]");
            sb.AppendLine("}");
            var manifestPath = Path.Combine(_telemetryDir, "run_manifest.json");
            File.WriteAllText(manifestPath, sb.ToString());
        }

        private static string EscapeJson(string value)
        {
            if (string.IsNullOrEmpty(value))
            {
                return string.Empty;
            }

            return value.Replace("\\", "\\\\").Replace("\"", "\\\"");
        }

        private void ExportPhase2Candidates(List<List<CandidateEvaluation>> tierCandidates,
            IList<TierTarget> tierTargets)
        {
            var levelGroup = ResolveExportLevelGroup(_config);
            var lines = new List<string>
            {
                "LevelGroup,Tier,Rank,ConfiguredTargetWinRate,EffectiveTargetWinRate,TargetClamped,OutOfMargin,WinRate," +
                "WinRateMatch,CompositeScore,FailDistScore,StdErr,PosteriorStd,RawGap,OverlapGap,SourcePhase,TotalRuns,Phase2Appended," +
                "StartDifficulty,ShuffleSplitCount,ShuffleSplitRatios,ShuffleOverflowFactor"
            };
            for (var t = 0; t < tierCandidates.Count; t++)
            {
                var target = tierTargets != null && t < tierTargets.Count ? tierTargets[t] : null;
                var tierName = target?.name ?? $"Tier{t + 1}";
                for (var r = 0; r < tierCandidates[t].Count; r++)
                {
                    var eval = tierCandidates[t][r];
                    lines.Add(
                        $"{levelGroup},{tierName},{r + 1}," +
                        $"{eval.configuredTargetWinRate.ToString("0.00", CultureInfo.InvariantCulture)}," +
                        $"{eval.effectiveTargetWinRate.ToString("0.00", CultureInfo.InvariantCulture)}," +
                        $"{eval.targetClamped}," +
                        $"{eval.outOfTargetMargin}," +
                        $"{eval.winRate.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                        $"{eval.winRateMatch.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                        $"{eval.compositeScore.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                        $"{eval.failDistScore.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                        $"{eval.stdErr.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                        $"{eval.posteriorStd.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                        $"{eval.rawGap.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                        $"{eval.overlapGap.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                        $"{eval.sourcePhase ?? "p2"}," +
                        $"{eval.totalRuns}," +
                        $"{eval.Phase2Appended.ToString().ToLowerInvariant()}," +
                        $"{eval.candidate.startDifficulty}," +
                        $"{eval.candidate.shuffleSplitCount}," +
                        $"\"{eval.candidate.TelemetryShuffleSplitRatiosCsv()}\"," +
                        $"{eval.candidate.overflowFactor.ToString("0.000", CultureInfo.InvariantCulture)}"
                    );
                }
            }

            File.WriteAllText(Path.Combine(_telemetryDir, "phase2_candidates.csv"), string.Join("\n", lines));
            Debug.Log($"[MultiTierOptimizer] Phase2 candidates exported ({tierCandidates.Sum(tc => tc.Count)} total)");
        }

        private void ExportFinalCsv(List<CandidateEvaluation> finalResults)
        {
            ExportToCsv(finalResults, null, _level, _config, _telemetryDir);
        }

        private static int ResolveExportDifficultyLevel(LevelProfileConfig level, MultiTierConfig config)
        {
            if (config != null && config.difficultyLevel >= 0)
            {
                return config.difficultyLevel;
            }

            return level != null ? (int) level.DifficultyLevel : 0;
        }

        private static string ResolveExportLevelGroup(MultiTierConfig config)
        {
            var raw = config?.levelGroup;
            return string.IsNullOrWhiteSpace(raw) ? BlastLevelGroupUtil.DefaultFolderName : raw.Trim();
        }

        public static void ExportToCsv(List<CandidateEvaluation> finalResults, List<CandidateEvaluation> phase1Evals,
            LevelProfileConfig level, MultiTierConfig config, string outputDir = null)
        {
            var outDir = outputDir;
            if (string.IsNullOrWhiteSpace(outDir))
            {
                var projectRoot = Directory.GetParent(Application.dataPath)?.FullName ?? Application.dataPath;
                var levelName = level != null ? level.name : "unknown";
                outDir = BlastBotExportPathConfig.BuildMultiTierStandaloneLevelDir(projectRoot, levelName);
            }

            Directory.CreateDirectory(outDir);

            var exportDifficultyLevel = ResolveExportDifficultyLevel(level, config);
            var exportLevelGroup = ResolveExportLevelGroup(config);
            var boardFingerprint = BlastLevelFingerprintUtility.ComputeBoardFingerprint(level);

            // Summary CSV
            var summaryPath = Path.Combine(outDir, "summary.csv");
            var summaryLines = new List<string>
            {
                "LevelGroup,GameLevel,Tier,Rank,FingerprintAlgorithm,BoardFingerprint,DealFingerprint,ConfiguredTargetWinRate,EffectiveTargetWinRate,TargetClamped,OutOfMargin," +
                "Status,SourcePhase,RawGap,OverlapGap," +
                "VerifiedWinRate,WinRateMatch,CI95,StdErr,PosteriorStd,FailDistScore,failBucketDistribution,TotalRuns,PlannedRuns,StopReason," +
                "StartDifficulty,ShuffleSplitCount,ShuffleSplitRatios,ShuffleOverflowFactor,DifficultyLevel"
            };

            var outputCount = Math.Max(1, config.outputCount);
            for (var i = 0; i < finalResults.Count; i++)
            {
                var eval = finalResults[i];
                var tierIdx = i / outputCount;
                var rank = i % outputCount;
                var target = tierIdx < config.tiers.Count ? config.tiers[tierIdx] : null;
                var targetWr = target?.targetWinRate ?? 0f;
                var configuredWr = eval.configuredTargetWinRate > 0f ? eval.configuredTargetWinRate : targetWr;
                var effectiveWr = eval.effectiveTargetWinRate > 0f ? eval.effectiveTargetWinRate : targetWr;
                var ci95 = 1.96f * eval.stdErr;
                var tierName = target?.name ?? $"Tier{tierIdx + 1}";

                var failBucketDist =
                    FormatFailBucketDistributionCsv(eval.failBins, eval.failCount, config.failBinCount);
                var statusText = string.IsNullOrEmpty(eval.status) ? "ok" : eval.status;
                var sourcePhaseText = eval.sourcePhase ?? "";
                var stopReasonText = !string.IsNullOrEmpty(eval.failureReason)
                    ? eval.failureReason
                    : (eval.stopReason ?? "");
                var startDifficulty = eval.candidate != null ? eval.candidate.startDifficulty : 0;
                var shuffleSplitCount = eval.candidate != null ? eval.candidate.shuffleSplitCount : 0;
                var ratiosCsv = eval.candidate != null ? eval.candidate.TelemetryShuffleSplitRatiosCsv() : "";
                var overflowFactor = eval.candidate != null ? eval.candidate.overflowFactor : 0f;
                var dealFingerprint = BlastLevelFingerprintUtility.ComputeDealFingerprint(
                    startDifficulty,
                    shuffleSplitCount,
                    ratiosCsv,
                    overflowFactor);
                summaryLines.Add(
                    $"{exportLevelGroup},{config.gameLevel},{tierName},{rank + 1}," +
                    $"{BlastLevelFingerprintUtility.FingerprintAlgorithm}," +
                    $"{boardFingerprint}," +
                    $"{dealFingerprint}," +
                    $"{configuredWr.ToString("0.00", CultureInfo.InvariantCulture)}," +
                    $"{effectiveWr.ToString("0.00", CultureInfo.InvariantCulture)}," +
                    $"{eval.targetClamped}," +
                    $"{eval.outOfTargetMargin}," +
                    $"{statusText}," +
                    $"{sourcePhaseText}," +
                    $"{eval.rawGap.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                    $"{eval.overlapGap.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                    $"{eval.winRate.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                    $"{eval.winRateMatch.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                    $"{ci95.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                    $"{eval.stdErr.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                    $"{eval.posteriorStd.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                    $"{eval.failDistScore.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                    $"\"{failBucketDist}\"," +
                    $"{eval.totalRuns}," +
                    $"{eval.plannedRuns}," +
                    $"\"{stopReasonText}\"," +
                    $"{startDifficulty}," +
                    $"{shuffleSplitCount}," +
                    $"\"{ratiosCsv}\"," +
                    $"{overflowFactor.ToString("0.000", CultureInfo.InvariantCulture)}," +
                    $"{exportDifficultyLevel}"
                );
            }

            File.WriteAllText(summaryPath, string.Join("\n", summaryLines));

            // Detail CSV
            var detailPath = Path.Combine(outDir, "detail.csv");
            var detailLines = new List<string>
            {
                "LevelGroup,GameLevel,Tier,Rank,FingerprintAlgorithm,BoardFingerprint,DealFingerprint,ConfiguredTargetWinRate,EffectiveTargetWinRate,TargetClamped,OutOfMargin," +
                "ActualWinRate,WinRateMatch,StdErr,PosteriorStd,CI95,FailDistScore," +
                string.Join(",", Enumerable.Range(1, config.failBinCount).Select(i => $"FailBin_{i}")) + "," +
                "StartDifficulty,ShuffleSplitCount,ShuffleSplitRatios,ShuffleOverflowFactor,TotalRuns,PlannedRuns,StopReason,DifficultyLevel"
            };

            for (var i = 0; i < finalResults.Count; i++)
            {
                var eval = finalResults[i];
                var tierIdx = i / outputCount;
                var rank = i % outputCount;
                var target = tierIdx < config.tiers.Count ? config.tiers[tierIdx] : null;
                var targetWr = target?.targetWinRate ?? 0f;
                var configuredWr = eval.configuredTargetWinRate > 0f ? eval.configuredTargetWinRate : targetWr;
                var effectiveWr = eval.effectiveTargetWinRate > 0f ? eval.effectiveTargetWinRate : targetWr;
                var ci95 = 1.96f * eval.stdErr;
                var tierName = target?.name ?? $"Tier{tierIdx + 1}";
                var startDifficulty = eval.candidate != null ? eval.candidate.startDifficulty : 0;
                var shuffleSplitCount = eval.candidate != null ? eval.candidate.shuffleSplitCount : 0;
                var ratiosCsv = eval.candidate != null ? eval.candidate.TelemetryShuffleSplitRatiosCsv() : "";
                var overflowFactor = eval.candidate != null ? eval.candidate.overflowFactor : 0f;
                var dealFingerprint = BlastLevelFingerprintUtility.ComputeDealFingerprint(
                    startDifficulty,
                    shuffleSplitCount,
                    ratiosCsv,
                    overflowFactor);
                var binValues = new List<string>();
                for (var b = 0; b < config.failBinCount; b++)
                    binValues.Add((eval.failBins != null && b < eval.failBins.Length ? eval.failBins[b] : 0)
                        .ToString());

                detailLines.Add(
                    $"{exportLevelGroup},{config.gameLevel},{tierName},{rank + 1}," +
                    $"{BlastLevelFingerprintUtility.FingerprintAlgorithm}," +
                    $"{boardFingerprint}," +
                    $"{dealFingerprint}," +
                    $"{configuredWr.ToString("0.00", CultureInfo.InvariantCulture)}," +
                    $"{effectiveWr.ToString("0.00", CultureInfo.InvariantCulture)}," +
                    $"{eval.targetClamped}," +
                    $"{eval.outOfTargetMargin}," +
                    $"{eval.winRate.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                    $"{eval.winRateMatch.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                    $"{eval.stdErr.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                    $"{eval.posteriorStd.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                    $"{ci95.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                    $"{eval.failDistScore.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                    $"{string.Join(",", binValues)}," +
                    $"{startDifficulty}," +
                    $"{shuffleSplitCount}," +
                    $"\"{ratiosCsv}\"," +
                    $"{overflowFactor.ToString("0.000", CultureInfo.InvariantCulture)}," +
                    $"{eval.totalRuns}," +
                    $"{eval.plannedRuns}," +
                    $"\"{eval.stopReason}\"," +
                    $"{exportDifficultyLevel}"
                );
            }

            File.WriteAllText(detailPath, string.Join("\n", detailLines));

            // Sensitivity CSV
            var sensitivityPath = Path.Combine(outDir, "sensitivity.csv");
            var sensLines = new List<string>
            {
                "LevelGroup,Tier,ConfiguredTargetWinRate,EffectiveTargetWinRate,ParamName,Direction,StepSize,WinRateBefore,WinRateAfter,DeltaWinRate,ScoreBefore,ScoreAfter,DeltaScore"
            };
            for (var i = 0; i < finalResults.Count; i++)
            {
                var eval = finalResults[i];
                var tierIdx = i / outputCount;
                var target = tierIdx < config.tiers.Count ? config.tiers[tierIdx] : null;
                var tierName = target?.name ?? $"Tier{tierIdx + 1}";
                var targetWr = target?.targetWinRate ?? 0f;
                var configuredWr = eval.configuredTargetWinRate > 0f ? eval.configuredTargetWinRate : targetWr;
                var effectiveWr = eval.effectiveTargetWinRate > 0f ? eval.effectiveTargetWinRate : targetWr;
                if (eval.sensitivities == null) continue;
                foreach (var s in eval.sensitivities)
                {
                    var deltaWr = s.winRateAfter - s.winRateBefore;
                    var deltaScore = s.compositeScoreAfter - s.compositeScoreBefore;
                    sensLines.Add(
                        $"{exportLevelGroup},{tierName}," +
                        $"{configuredWr.ToString("0.00", CultureInfo.InvariantCulture)}," +
                        $"{effectiveWr.ToString("0.00", CultureInfo.InvariantCulture)}," +
                        $"{s.paramName},{s.direction},{s.stepSize}," +
                        $"{s.winRateBefore.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                        $"{s.winRateAfter.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                        $"{deltaWr.ToString("+0.0000;-0.0000", CultureInfo.InvariantCulture)}," +
                        $"{s.compositeScoreBefore.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                        $"{s.compositeScoreAfter.ToString("0.0000", CultureInfo.InvariantCulture)}," +
                        $"{deltaScore.ToString("+0.0000;-0.0000", CultureInfo.InvariantCulture)}"
                    );
                }
            }

            File.WriteAllText(sensitivityPath, string.Join("\n", sensLines));

            // Phase 1 raw CSV
            if (phase1Evals != null && phase1Evals.Count > 0)
            {
                var rawPath = Path.Combine(outDir, "phase1_raw.csv");
                var rawLines = new List<string> {BuildPhase1RawCsvHeader()};

                foreach (var eval in phase1Evals)
                    rawLines.Add(FormatPhase1RawCsvLine(exportLevelGroup, eval));

                File.WriteAllText(rawPath, string.Join("\n", rawLines));
            }

            Debug.Log($"[MultiTierOptimizer] CSV exported to {outDir}");
            if (!Application.isBatchMode)
            {
                EditorUtility.RevealInFinder(summaryPath);
            }
        }

        private static string EscapeBatchCsvField(string value)
        {
            if (string.IsNullOrEmpty(value))
            {
                return string.Empty;
            }

            if (value.IndexOfAny(new[] {',', '"', '\n', '\r'}) >= 0)
            {
                return "\"" + value.Replace("\"", "\"\"") + "\"";
            }

            return value;
        }

        public static bool TryExportBatchLevelStatusCsv(
            string batchRootDir,
            IReadOnlyList<(int gameLevel, string status, string reason, string telemetryDir)> levelRows,
            string levelFolderTag,
            string levelGroup,
            out string outputPath)
        {
            outputPath = null;
            if (string.IsNullOrWhiteSpace(batchRootDir) || levelRows == null || levelRows.Count == 0)
            {
                return false;
            }

            Directory.CreateDirectory(batchRootDir);
            outputPath = Path.Combine(
                batchRootDir,
                BlastBotExportPathConfig.BuildMultiTierBatchLevelStatusCsvFileName(levelFolderTag));

            var exportLevelGroup = string.IsNullOrWhiteSpace(levelGroup)
                ? BlastLevelGroupUtil.DefaultFolderName
                : levelGroup.Trim();
            var lines = new List<string> {"LevelGroup,GameLevel,Status,Reason,TelemetryDir"};
            for (var i = 0; i < levelRows.Count; i++)
            {
                var row = levelRows[i];
                var telemetryDir = (row.telemetryDir ?? string.Empty).Replace('\\', '/');
                lines.Add(string.Join(",",
                    exportLevelGroup,
                    row.gameLevel.ToString(CultureInfo.InvariantCulture),
                    EscapeBatchCsvField(row.status ?? string.Empty),
                    EscapeBatchCsvField(row.reason ?? string.Empty),
                    EscapeBatchCsvField(telemetryDir)));
            }

            File.WriteAllText(outputPath, string.Join("\n", lines));
            Debug.Log($"[MultiTierOptimizer] Batch level status exported to {outputPath}");
            return true;
        }

        public static bool TryExportBatchSummaryCsv(
            string batchRootDir,
            IReadOnlyList<(int gameLevel, string telemetryDir)> completedLevels,
            string levelFolderTag,
            out string outputPath)
        {
            outputPath = null;
            if (string.IsNullOrWhiteSpace(batchRootDir) || completedLevels == null || completedLevels.Count == 0)
            {
                return false;
            }

            Directory.CreateDirectory(batchRootDir);
            outputPath = Path.Combine(
                batchRootDir,
                BlastBotExportPathConfig.BuildMultiTierBatchSummaryCsvFileName(levelFolderTag));

            var mergedLines = new List<string>();
            var headerWritten = false;
            foreach (var entry in completedLevels)
            {
                var summaryPath = Path.Combine(entry.telemetryDir, BlastBotExportPathConfig.MultiTierLevelSummaryCsvName);
                if (!File.Exists(summaryPath))
                {
                    Debug.LogWarning(
                        $"[MultiTierOptimizer] Batch summary skip missing file: level=L{entry.gameLevel} path={summaryPath}");
                    continue;
                }

                var lines = File.ReadAllLines(summaryPath);
                if (lines.Length <= 0)
                {
                    continue;
                }

                if (!headerWritten)
                {
                    mergedLines.Add(lines[0]);
                    headerWritten = true;
                }

                for (var i = 1; i < lines.Length; i++)
                {
                    if (string.IsNullOrWhiteSpace(lines[i]))
                    {
                        continue;
                    }

                    mergedLines.Add(lines[i]);
                }
            }

            if (!headerWritten || mergedLines.Count <= 1)
            {
                outputPath = null;
                return false;
            }

            File.WriteAllText(outputPath, string.Join("\n", mergedLines));
            Debug.Log($"[MultiTierOptimizer] Batch summary exported to {outputPath}");
            return true;
        }
    }
}
