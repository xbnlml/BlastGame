using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;
using UnityEngine;
using Random = System.Random;

namespace GameModule.Editor.Bot
{
    /// <summary>
    ///     Phase1 采样：R1a preset 广覆盖 → R1b 曲线二分补洞 → R2 未满足档邻域等量加密。
    /// </summary>
    internal static class BlastMultiTierPhase1AdaptiveSampler
    {
        internal const int Round1PresetCount = 15;
        internal const int UniqueCandidateMaxAttempts = 16;
        internal const int Round1BinaryFillMaxDepthPerSegment = 5;
        internal const int Round1BinaryFillGlobalCap = 16;
        internal const int Round2DensifyPerSeedDefault = 4;
        internal const int Round2SeedCountPerTarget = 1;
        internal const int Round2NeighborhoodStep = 2;

        /// <summary>
        ///     Phase1 R1a 难度轴刻度（含端点 0/40）。sd 越高洗牌越多越难（不绝对，实测为准）。
        ///     外层按此顺序遍历，先保最易/最难端点（预算不足时自然保端点）。
        /// </summary>
        internal static readonly int[] Round1SdScale = {0, 10, 20, 30, 40};
        internal const int Round1SdCount = 5;

        /// <summary>与 Round1SdScale 一一对应的 of。sd 低→of 低（几乎不洗），sd 高→of 高（强溢出重排）。
        /// 注意：sd&lt;30 时 overflowTotal=0，of 实际空转（表意性协同，无副作用）。</summary>
        internal static readonly float[] Round1SdOverflow = {0f, 0.25f, 0.5f, 0.75f, 1f};

        /// <summary>R1a 总候选数 = 5 sd × 15 有效 ratio 模式。</summary>
        internal const int Round1TotalPresetCount = Round1SdCount * Round1PresetCount;

        /// <summary>
        ///     15 个可名状 ratio 形状（原 16 个，1→0 表达"该段退出洗牌池"，删冗余 #15 {5,5,1,5,5}）。
        ///     服务端 AllocateShuffleCounts 只看相对比例，故 {10,10,0,10,10}≡{5,5,0,5,5}，后者已删。
        ///     0=该段不洗（分配 0 + 余数剔除），比 1 更彻底。
        /// </summary>
        private static readonly int[][] RatioPresets =
        {
            new[] {10, 0, 0, 0, 0},
            new[] {0, 10, 0, 0, 0},
            new[] {0, 0, 10, 0, 0},
            new[] {0, 0, 0, 10, 0},
            new[] {0, 0, 0, 0, 10},
            new[] {10, 10, 0, 0, 0},
            new[] {0, 0, 0, 10, 10},
            new[] {10, 10, 10, 0, 0},
            new[] {0, 0, 10, 10, 10},
            new[] {0, 10, 10, 10, 0},
            new[] {10, 0, 0, 0, 10},
            new[] {10, 10, 0, 10, 10},
            new[] {0, 10, 0, 10, 0},
            new[] {10, 0, 10, 0, 10},
            new[] {0, 0, 0, 0, 0}
        };

        /// <summary>判断 ratios 是否全 0（服务端 AllocateShuffleCounts sum<=0 无条件零洗牌，与 sd 无关）。</summary>
        private static bool IsAllZeroRatios(int[] ratios)
        {
            for (var i = 0; i < ratios.Length; i++)
            {
                if (ratios[i] > 0)
                {
                    return false;
                }
            }

            return true;
        }

        internal sealed class Phase1AdaptivePlan
        {
            public ParameterCandidate candidate;
            public string targetLabel;
        }

        /// <summary>
        ///     在 startDifficulty / ratios 上扰动，直到 ToKey 不在 seenKeys 中；seenKeys 为 null 时直接克隆返回。
        /// </summary>
        internal static ParameterCandidate EnsureUniqueCandidate(
            MultiTierConfig config,
            ParameterCandidate baseCandidate,
            ISet<string> seenKeys,
            int salt)
        {
            if (baseCandidate == null)
            {
                return null;
            }

            if (seenKeys == null)
            {
                return baseCandidate.Clone();
            }

            var attempt = baseCandidate.Clone();
            for (var nudge = 0; nudge < UniqueCandidateMaxAttempts; nudge++)
            {
                var key = attempt.ToKey();
                if (!seenKeys.Contains(key))
                {
                    return attempt;
                }

                attempt = baseCandidate.Clone();
                var magnitude = (nudge % 7) + 1;
                var sdDelta = magnitude * (nudge % 2 == 0 ? 1 : -1);
                attempt.startDifficulty = Mathf.Clamp(
                    attempt.startDifficulty + sdDelta,
                    config.startDifficultyMin,
                    config.startDifficultyMax);

                if (attempt.ratios != null && attempt.ratios.Length > 0 && nudge >= 4)
                {
                    var slot = Mathf.Abs(salt + nudge) % attempt.ratios.Length;
                    var ratioDelta = nudge % 2 == 0 ? 1 : -1;
                    attempt.ratios[slot] = Mathf.Clamp(
                        attempt.ratios[slot] + ratioDelta,
                        config.ratioMin,
                        config.ratioMax);
                }
            }

            return null;
        }

        /// <summary>
        ///     第 1 轮固定跑 ratio preset，先把“偏易 -> 偏难”的 ratio 轮廓测出来。
        /// </summary>
                internal static List<Phase1AdaptivePlan> BuildRound1Plans(
            MultiTierConfig config,
            int count,
            ISet<string> seenKeys)
        {
            var plans = new List<Phase1AdaptivePlan>(Mathf.Max(0, count));
            var emitted = 0;
            // sd 顺序：先保最易(0)/最难(40)端点，预算不足时自然保端点。顺序：0,40,10,30,20。
            var sdOrder = new[] {0, 4, 1, 3, 2};
            for (var si = 0; si < Round1SdCount && emitted < count; si++)
            {
                var sdIndex = sdOrder[si];
                var sd = Round1SdScale[sdIndex];
                var of = Round1SdOverflow[sdIndex];
                for (var ri = 0; ri < RatioPresets.Length && emitted < count; ri++)
                {
                    // 全 0 模板只试一个 sd（sdIndex==0，最易端点）。全 0 时 AllocateShuffleCounts 的
                    // sum<=0 无条件返回全 0（完全不洗），与 sd 无关，故配哪个 sd 效果相同，只试一个避免 4 次重复 sim。
                    if (IsAllZeroRatios(RatioPresets[ri]) && sdIndex != 0)
                    {
                        continue;
                    }

                    var raw = CreateFixedCandidate(config, RatioPresets[ri], sd);
                    raw.overflowFactor = of;
                    var candidate = EnsureUniqueCandidate(config, raw, seenKeys, emitted);
                    if (candidate == null)
                    {
                        continue;
                    }

                    seenKeys?.Add(candidate.ToKey());
                    plans.Add(new Phase1AdaptivePlan
                    {
                        candidate = candidate,
                        targetLabel = "round1 sd=" + sd + " preset " + (ri + 1) + "/" + RatioPresets.Length
                    });
                    emitted++;
                }
            }

            return plans;
        }
        
        /// <summary>
        ///     R1b：对未满足目标，若带内为空则在 WR 曲线分段上做二分补洞；每段最多 2 次，全局有硬顶。
        ///     调用方应在每批评估后带着更新后的 evals 再次调用，直到返回空或达上限。
        /// </summary>
        internal static List<Phase1AdaptivePlan> BuildRound1BinaryFillPlans(
            MultiTierConfig config,
            IList<float> focusConfiguredTargets,
            IList<CandidateEvaluation> curveEvals,
            float margin,
            ISet<string> seenKeys,
            Dictionary<string, int> segmentDepth,
            int remainingGlobalCap)
        {
            var plans = new List<Phase1AdaptivePlan>();
            if (config == null || focusConfiguredTargets == null || focusConfiguredTargets.Count == 0 ||
                remainingGlobalCap <= 0)
            {
                return plans;
            }

            var ordered = SortEvalsByWinRateAscending(curveEvals);
            if (ordered.Count == 0)
            {
                return plans;
            }

            var safeMargin = Mathf.Max(0f, margin);
            for (var ti = 0; ti < focusConfiguredTargets.Count; ti++)
            {
                if (plans.Count >= remainingGlobalCap)
                {
                    break;
                }

                var target = Mathf.Clamp01(focusConfiguredTargets[ti]);
                if (CountSamplesInBand(ordered, target, safeMargin) > 0)
                {
                    continue;
                }

                if (!TryResolveBinaryFillBracket(ordered, target, config, out var left, out var right,
                        out var segmentKey))
                {
                    continue;
                }

                segmentDepth ??= new Dictionary<string, int>();
                segmentDepth.TryGetValue(segmentKey, out var depth);
                if (depth >= Round1BinaryFillMaxDepthPerSegment)
                {
                    continue;
                }

                var midSd = ResolveBinaryMidStartDifficulty(left, right, target, config);
                var ratioSource = PickCloserEval(left, right, target)?.candidate?.ratios;
                var salt = Mathf.RoundToInt(target * 1000f) + depth * 17 + midSd;
                // sd 撞到边界（min/max）时二分无法再细分 → 转切 ratios/of 变体（sd 饱和，换第二杠杆）。
                var sdClamped = midSd <= config.startDifficultyMin || midSd >= config.startDifficultyMax;
                var raw = CreateFixedCandidate(config, ratioSource, midSd);
                if (sdClamped && raw.ratios != null && raw.ratios.Length > 0)
                {
                    // 对离目标更近的 bracket 的 ratios 做 ±1 扰动，探索新形状；of 加一个变体
                    var slot = Mathf.Abs(salt) % raw.ratios.Length;
                    raw.ratios[slot] = Mathf.Clamp(raw.ratios[slot] + (depth % 2 == 0 ? 1 : -1),
                        config.ratioMin, config.ratioMax);
                    raw.overflowFactor = Mathf.Clamp(raw.overflowFactor + (depth % 3) * 0.1f,
                        config.overflowFactorMin, config.overflowFactorMax);
                }
                var candidate = EnsureUniqueCandidate(config, raw, seenKeys, salt);
                if (candidate == null)
                {
                    continue;
                }

                seenKeys?.Add(candidate.ToKey());
                segmentDepth[segmentKey] = depth + 1;
                plans.Add(new Phase1AdaptivePlan
                {
                    candidate = candidate,
                    targetLabel = "r1_fill target " + target.ToString("P0", CultureInfo.InvariantCulture)
                                  + " depth " + (depth + 1)
                                + (sdClamped ? " (sd-clamped, ratios/of variant)" : "")
                });
            }

            return plans;
        }

        /// <summary>
        ///     R2：仅对 focus 目标，在合格 R1 邻域做等量 SD 加密（每目标 1 种子 × densifyPerSeed）。
        ///     主方向仍朝目标胜率；可选 <paramref name="searchRandom"/> 对每个 logical sample 做有界 SD/ratio 微扰。
        /// </summary>
        internal static List<Phase1AdaptivePlan> BuildRound2NeighborhoodPlans(
            MultiTierConfig config,
            IList<float> focusConfiguredTargets,
            IList<CandidateEvaluation> poolEvals,
            float margin,
            int densifyPerSeed,
            ISet<string> seenKeys,
            int maxPlans,
            Random searchRandom = null)
        {
            var plans = new List<Phase1AdaptivePlan>();
            if (config == null || focusConfiguredTargets == null || focusConfiguredTargets.Count == 0 ||
                densifyPerSeed <= 0 || maxPlans <= 0)
            {
                return plans;
            }

            var safeMargin = Mathf.Max(0f, margin);
            var perSeed = Mathf.Max(1, densifyPerSeed);
            for (var ti = 0; ti < focusConfiguredTargets.Count; ti++)
            {
                if (plans.Count >= maxPlans)
                {
                    break;
                }

                var target = Mathf.Clamp01(focusConfiguredTargets[ti]);
                var seed = SelectNeighborhoodSeed(poolEvals, target, safeMargin);
                if (seed?.candidate == null)
                {
                    continue;
                }

                var towardHigherWinRate = seed.winRate + 0.0001f < target;
                var sdDirection = towardHigherWinRate ? -1 : 1;
                var baseSd = seed.candidate.startDifficulty;
                for (var step = 1; step <= perSeed && plans.Count < maxPlans; step++)
                {
                    var sdJitter = 0;
                    var ratioSlot = -1;
                    var ratioDelta = 0;
                    if (searchRandom != null)
                    {
                        sdJitter = searchRandom.Next(-1, 2);
                        if (seed.candidate.ratios != null && seed.candidate.ratios.Length > 0
                            && searchRandom.Next(0, 2) == 0)
                        {
                            ratioSlot = searchRandom.Next(0, seed.candidate.ratios.Length);
                            ratioDelta = searchRandom.Next(0, 2) == 0 ? -1 : 1;
                        }
                    }

                    var raw = CreateFixedCandidate(
                        config,
                        seed.candidate.ratios,
                        baseSd + sdDirection * Round2NeighborhoodStep * step + sdJitter);
                    if (ratioSlot >= 0 && raw.ratios != null && ratioSlot < raw.ratios.Length)
                    {
                        raw.ratios[ratioSlot] = Mathf.Clamp(
                            raw.ratios[ratioSlot] + ratioDelta,
                            config.ratioMin,
                            config.ratioMax);
                    }

                    var salt = ti * 100 + step * 19 + Mathf.RoundToInt(target * 1000f) + sdJitter * 7;
                    var candidate = EnsureUniqueCandidate(config, raw, seenKeys, salt);
                    if (candidate == null)
                    {
                        continue;
                    }

                    seenKeys?.Add(candidate.ToKey());
                    plans.Add(new Phase1AdaptivePlan
                    {
                        candidate = candidate,
                        targetLabel = "round2 densify "
                                      + target.ToString("P0", CultureInfo.InvariantCulture)
                                      + " step " + step + "/" + perSeed
                    });
                }
            }

            return plans;
        }

        /// <summary>
        ///     创建 Phase1 固定参数候选；split/overflow 统一走当前配置。
        /// </summary>
        internal static ParameterCandidate CreateFixedCandidate(MultiTierConfig config, int[] sourceRatios,
            int startDifficulty)
        {
            var ratioLength = Mathf.Max(
                Mathf.Max(1, config.ratioSlots),
                Mathf.Max(config.shuffleSplitCountMax, config.phase1FixedShuffleSplitCount));
            var candidate = new ParameterCandidate
            {
                startDifficulty = Mathf.Clamp(startDifficulty, config.startDifficultyMin, config.startDifficultyMax),
                shuffleSplitCount = Mathf.Clamp(
                    config.phase1FixedShuffleSplitCount,
                    config.shuffleSplitCountMin,
                    config.shuffleSplitCountMax),
                overflowFactor = Mathf.Clamp(
                    config.phase1FixedOverflowFactor,
                    config.overflowFactorMin,
                    config.overflowFactorMax),
                ratios = Enumerable.Repeat(1, ratioLength).ToArray()
            };
            if (sourceRatios == null)
            {
                return candidate;
            }

            var copyLength = Mathf.Min(sourceRatios.Length, candidate.ratios.Length);
            for (var i = 0; i < copyLength; i++)
            {
                candidate.ratios[i] = Mathf.Clamp(sourceRatios[i], config.ratioMin, config.ratioMax);
            }

            return candidate;
        }

        private static List<CandidateEvaluation> SortEvalsByWinRateAscending(IList<CandidateEvaluation> evals)
        {
            var ordered = new List<CandidateEvaluation>();
            if (evals == null)
            {
                return ordered;
            }

            for (var i = 0; i < evals.Count; i++)
            {
                if (evals[i]?.candidate != null)
                {
                    ordered.Add(evals[i]);
                }
            }

            ordered.Sort((a, b) => a.winRate.CompareTo(b.winRate));
            return ordered;
        }

        private static bool TryResolveBinaryFillBracket(
            IList<CandidateEvaluation> orderedAscending,
            float target,
            MultiTierConfig config,
            out CandidateEvaluation left,
            out CandidateEvaluation right,
            out string segmentKey)
        {
            left = null;
            right = null;
            segmentKey = null;
            if (orderedAscending == null || orderedAscending.Count == 0)
            {
                return false;
            }

            for (var i = 0; i < orderedAscending.Count - 1; i++)
            {
                var a = orderedAscending[i];
                var b = orderedAscending[i + 1];
                if (a.winRate + 0.0001f < target && target < b.winRate - 0.0001f)
                {
                    left = a;
                    right = b;
                    segmentKey = BuildSegmentKey(a, b);
                    return true;
                }
            }

            var lowest = orderedAscending[0];
            var highest = orderedAscending[orderedAscending.Count - 1];
            if (target <= lowest.winRate + 0.0001f)
            {
                left = CreateBoundaryAnchor(lowest, config.startDifficultyMax);
                right = lowest;
                segmentKey = "low:" + lowest.candidate.ToKey();
                return left != null && right != null;
            }

            if (target >= highest.winRate - 0.0001f)
            {
                left = highest;
                right = CreateBoundaryAnchor(highest, config.startDifficultyMin);
                segmentKey = "high:" + highest.candidate.ToKey();
                return left != null && right != null;
            }

            return false;
        }

        private static CandidateEvaluation CreateBoundaryAnchor(CandidateEvaluation source, int boundarySd)
        {
            if (source?.candidate == null)
            {
                return null;
            }

            var c = source.candidate.Clone();
            c.startDifficulty = boundarySd;
            return new CandidateEvaluation
            {
                candidate = c,
                winRate = source.winRate
            };
        }

        private static string BuildSegmentKey(CandidateEvaluation left, CandidateEvaluation right)
        {
            var lk = left?.candidate != null ? left.candidate.ToKey() : "?";
            var rk = right?.candidate != null ? right.candidate.ToKey() : "?";
            return lk + "|" + rk;
        }

        private static int ResolveBinaryMidStartDifficulty(
            CandidateEvaluation left,
            CandidateEvaluation right,
            float target,
            MultiTierConfig config)
        {
            var sdL = left?.candidate != null ? left.candidate.startDifficulty : config.startDifficultyMin;
            var sdR = right?.candidate != null ? right.candidate.startDifficulty : config.startDifficultyMax;
            if (sdL == sdR)
            {
                var towardHigher = (left?.winRate ?? 0f) + 0.0001f < target;
                var nudged = sdL + (towardHigher ? -1 : 1);
                return Mathf.Clamp(nudged, config.startDifficultyMin, config.startDifficultyMax);
            }

            return Mathf.Clamp(
                Mathf.RoundToInt((sdL + sdR) * 0.5f),
                config.startDifficultyMin,
                config.startDifficultyMax);
        }

        private static CandidateEvaluation PickCloserEval(
            CandidateEvaluation left,
            CandidateEvaluation right,
            float target)
        {
            if (left == null)
            {
                return right;
            }

            if (right == null)
            {
                return left;
            }

            return Mathf.Abs(left.winRate - target) <= Mathf.Abs(right.winRate - target) ? left : right;
        }

        private static CandidateEvaluation SelectNeighborhoodSeed(
            IList<CandidateEvaluation> poolEvals,
            float target,
            float margin)
        {
            if (poolEvals == null || poolEvals.Count == 0)
            {
                return null;
            }

            CandidateEvaluation bestInBand = null;
            var bestInBandGap = float.MaxValue;
            CandidateEvaluation bestAny = null;
            var bestAnyGap = float.MaxValue;
            var bandLow = Mathf.Clamp01(target - margin);
            var bandHigh = Mathf.Clamp01(target + margin);
            for (var i = 0; i < poolEvals.Count; i++)
            {
                var eval = poolEvals[i];
                if (eval?.candidate == null)
                {
                    continue;
                }

                var gap = Mathf.Abs(eval.winRate - target);
                if (gap < bestAnyGap)
                {
                    bestAnyGap = gap;
                    bestAny = eval;
                }

                if (eval.winRate < bandLow - 0.0001f || eval.winRate > bandHigh + 0.0001f)
                {
                    continue;
                }

                if (gap < bestInBandGap)
                {
                    bestInBandGap = gap;
                    bestInBand = eval;
                }
            }

            return bestInBand ?? bestAny;
        }

        private static int CountSamplesInBand(IList<CandidateEvaluation> evals, float target, float margin)
        {
            var count = 0;
            var bandLow = Mathf.Clamp01(target - margin);
            var bandHigh = Mathf.Clamp01(target + margin);
            for (var i = 0; i < evals.Count; i++)
            {
                var eval = evals[i];
                if (eval == null)
                {
                    continue;
                }

                var winRate = Mathf.Clamp01(eval.winRate);
                if (winRate >= bandLow - 0.0001f && winRate <= bandHigh + 0.0001f)
                {
                    count++;
                }
            }

            return count;
        }
    }
}
