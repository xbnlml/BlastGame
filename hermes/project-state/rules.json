  "judge_rules": {
    "_note": "默认按较高档WR分档(20/15/10/6)；仅当目标档位差与分档冲突时按目标档位差(接近下限=档位差×0.7)",
    "normal": {
      "gap_bands": {
        "wr_ge_70": 20,
        "wr_ge_50": 15,
        "wr_ge_30": 10,
        "wr_lt_30": 6
      },
      "near_bands": {
        "wr_ge_70": 15,
        "wr_ge_50": 10,
        "wr_ge_30": 7,
        "wr_lt_30": 4
      },
      "anchor": {
        "t3_min": 50
      },
      "hard_violations": [
        "inverted>1",
        "wr<5",
        "t3<50",
        "low_count>1",
        "gap>40"
      ]
    },
    "hard": {
      "gap_bands": {
        "wr_ge_70": 20,
        "wr_ge_50": 15,
        "wr_ge_30": 10,
        "wr_lt_30": 6
      },
      "near_bands": {
        "wr_ge_70": 15,
        "wr_ge_50": 10,
        "wr_ge_30": 7,
        "wr_lt_30": 4
      },
      "anchor": {
        "t3_range": [
          30,
          50
        ]
      },
      "hard_violations": [
        "inverted>1",
        "wr<5",
        "t3<30 or>50",
        "low_count>1",
        "gap>40"
      ]
    },
    "superhard": {
      "gap_bands": {
        "wr_ge_70": 20,
        "wr_ge_50": 15,
        "wr_ge_30": 10,
        "wr_lt_30": 6
      },
      "near_bands": {
        "wr_ge_70": 15,
        "wr_ge_50": 10,
        "wr_ge_30": 7,
        "wr_lt_30": 4
      },
      "anchor": {
        "t3_max": 50
      },
      "hard_violations": [
        "inverted>1",
        "wr<5",
        "t3>50",
        "low_count>1",
        "gap>40"
      ]
    },
    "rounds": {
